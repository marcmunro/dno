#! /usr/bin/env bash
#
#       dno_bpp - Board and platform parser for dno
# 
#       Copyright (c) 2024,2025 Marc Munro
#       Author:  Marc Munro
# 	License: GPL-3.0
#

# The primary purpose of dno_bpp is to, in combination with dno,
# create a dno BOARD_INFO file for a given Arduino board-type.
# BOARD_INFO files contain all of the definitions needed to compile,
# upload, etc software for a given Arduino-like board.
#
# This is intended primarily for direct use by dno.
#
# It is implemented in bash and gawk in order to reduce dependencies
# on external packages.  Many more suitable development toolsets exist
# but all expose the user to greater system complexity and the
# potential for supply-chain attacks.

ARDUINO_BOARDS_FILE="@BOARDS_TXT@"
EXTRA_BOARDS_FILE="@DNO_EXTRA_BOARDS_FILE@"

DNO_VERSION="@DNO_VERSION@"
DNO_IDE_VERSION="@DNO_IDE_VERSION@"
HOST_OS="@HOST_OS@"

##
# error
# Print an error message to stderr and exit with an error status.
#
error()
{
    echo -e "dno_bpp error:" "$@" 1>&2
    exit 2
}

##
# version
#
# Print version information.
#
version()
{
    echo "`basename $0`: version ${DNO_VERSION} (part of the dno toolset)"
}

##
# usage
#
# Print a usage message.
#
usage()
{
    echo "dno_bpp [options] [board-specifier]
  Boards and platform parser for dno.

  Parses the boards.txt and platform.txt files to create
  inclusion-files for dno (make), to identify the available boards,
  and to create BOARD_TYPE and BOARD_INFO files.

  Options:
  -f, --full    Report the full board-specifier name with --type.
  -h, --help    Provide this help message and exit.
                Print this help message and exit.
  -l, --list    List the available boards, filtered by board-specifier
  -n, -no_options
	        Do not warn about unused board options with --type
  -o, --options Print options (menu options) for boards.  This only
                makes sense in combination with --list
  -p, --parse   Parse the appropriate boards.txt and platforms.txt
      		files for a single specified board with output to
		stdout.  The output may be saved in a BOARD_INFO file.
  -t, --type    Print a board type string.  This can be saved in a 
      		BOARD_TYPE file, or used as the directory name for a 
		board directory.
  -x            Run as a helper to identify a path.
  --version, -v	Print version information and exit.
"
}

##
# all_board_paths
#
# Print, to stdout, the vendor, core and full path to the boards.txt
# file for all of our significant boards.txt files, with each field
# separated by colons.
# Note that later entries in our files take precedence over earlier
# entries for the same vendor and core.
#
all_board_paths()
{
    (
        echo ${ARDUINO_BOARDS_FILE}
        if [ -r ${EXTRA_BOARDS_FILE} ]; then
	    sed -e 's/#.*//' <"${EXTRA_BOARDS_FILE}"
        fi
    ) | gawk '
        /hardware/ {
	    elems = split($0, parts, "/")
	    for (i = 1; i < elems; i++) {
	        if (parts[i] == "hardware") {
		    # We have found the hardware element.  Now we want
		    # to identify vendor and architecture.  The
		    # platform specification and reality differ
		    # on how to find this!
		    if (parts[i + 2] ~ /^[0-9]+/) {
		       # The second dir after hardware looks like a
		       # version number.  This matches our experience
		       # of the arduino dir structure.
		       vendor = parts[i - 1]
		       architecture = parts[i + 1]
		    }
		    else {
		       # Assume this matches the platform specification
		       vendor = parts[i + 1]
		       architecture = parts[i + 2]
		    }
		    break
		}
	    }
	    # Record each line in an array indexed by vendor and
	    # architecture.  This will eliminate paths that are
	    # superceded by later alternatives in our
	    # EXTRA_BOARDS_FILE: only the latest entry for a vendor
	    # and architecture will be retained.
	    results[vendor][architecture] = $0
	}
	END {
	    # Print the retained lines
	    for (i in results) {
	        for (j in results[i]) {
		    path = results[i][j]
		    sub("/?boards.txt$", "", path)
		    sub("^~/", HOME "/", path)
		    if ((getline < (path "/boards.txt")) > 0) {
		        printf("%s:%s:%s\n", i, j, path "/boards.txt");
		    }
		    if ((getline < (path "/boards.local.txt")) > 0) {
		        printf("%s:%s:%s\n", i, j, path "/boards.local.txt");
		    }
	    	}
	    }
	}
    ' HOME="${HOME}"
}

##
# all_boards
#
# Prints, to stdout, all boards from the boards.txt files, specified in
# board_paths, in the form: vendor.architecture.board_name
#
# Requires board_paths to be defined.
# 
all_boards()
{
    local line
    echo "${board_paths}" |
	while read line; do
            IFS=':' read -a field <<< "${line}"
	    filepath=`echo "${line}" | cut -d: -f3-`
	    sed -n "/^[^\.]*\.name=/s/^\([^\.]*\).*/${field[0]}.${field[1]}.\1/p" <"${filepath}"
        done
}

##
# get_matching_vendors
#
# From board_paths, identifies vendors and architectures that match $1,
# a vendor name.  The matches are printed to stdout in the form:
# vendor.architecture.*
#
# Requires board_paths to be defined
# 
get_matching_vendors()
{
    echo "${board_paths}" | grep "^${1}:" | \
	sed -e 's!\(^[^:]*\):\([^:]*\):.*!\1.\2.*!'
}

##
# get_matching_arch
#
# From board_paths, identifies vendors and architectures that match $1,
# an archirecture name.  The matches are printed to stdout in the form:
# vendor.architecture.*
#
# Requires board_paths to be defined
# 
get_matching_arch()
{
    echo "${board_paths}" | grep "^[^:]*:${1}:" | \
	sed -e 's!\(^[^:]*\):\([^:]*\):.*!\1.\2.*!'
}

##
# get_board_candidates
#
# Prints, to stdout, matches for $1 which is a component of a
# board-specifier and may specify vendor, architecture, or board-name.
#
# The output will be in the form:
#   vendor.architecture.board-name, if $1 matches a board, plus
#   vendor.architecture.* if it explicitly matches a vendor and/or
# architecture.
#
# This function will be called for each of the first 3 parts of a
# dot-separated board-specifier.  The prepended $2 allows the caller
# to identify which part of a board-specifier we are currently
# matching.
#
# $1 is a field from our board-specifier
#
# Requires board_paths and all_boards to be defined
#
get_board_candidates()
{
    if [ "x$2" != "x3" ]; then
	get_matching_vendors "$1"
	get_matching_arch "$1"
    fi
    echo "${all_boards}" | grep "\.$1$"
}

##
# qualify_one
#
# Check whether a $1 is a match for the remaining parameters, which
# are the components of our board-specifier.  If there is a match $1
# will be printed to stdout.
#
# $1 will have been derived from get_board_candidates().
# $@ (the remaining args) are the separate parts of the board
# specifier, possibly truncated to remove menu options.
#
qualify_one()
{
    local match="$1"
    local matched=no

    shift 
    local spec_parts=("$@")

    IFS=. read -a match_parts <<<"${match}"

    if [ "x${#spec_parts[@]}" = "x1" ]; then
	# We only have a single part in our board-specifier so no
	# filtering is possible
	matched=yes
    else
	if [ "x${#spec_parts[@]}" = "x3" ]; then
	    # Our board-param has three parts.  All need
	    # to match.
	    if [[ "${spec_parts[@]}" == "${match_parts[@]}" ]]; 
	    then
		matched=yes
	    fi
	else
	    # Our param has 2 parts.  The first may be the
	    # vendor or architecture.  The second may be
	    # architecture or board.
	    if [ "${spec_parts[0]}" = "${match_parts[0]}" -o \
		 "${spec_parts[0]}" = "${match_parts[1]}" ]
	    then
		if [ "${spec_parts[1]}" = "${match_parts[1]}" -o \
		     "${spec_parts[1]}" = "${match_parts[2]}" ]
		then
		    matched=yes
		fi
	    fi
	fi
    fi
    if [ ${matched} = yes ]; then
	echo ${match}
    fi
}

##
# bfile_for_board
#
# Print to stdout the boards.txt file that seems to be the best match
# for the parameters.
#
# $1-3 board specifier parts
#
# Requires board_paths to be provided
#
bfile_for_board()
{
    grep "$1:$2:" <<<"${board_paths}" |
	sed -e s'/^[^:]*:[^:]*://' |
	while read path; do
	    # check that boards file contains a reference to our board
	    grep -l "^$3\.name=" "${path}"
	done | tail -1  # Only issue the last match
}

##
# options_for_board
#
# Print to stdout the options and possible values for all menu options
# for the board identified by the parameters.  The output is in the
# form: <option_name>=<option_value>|<option description>
#
# $1-3 board specifier parts
# $4 path to boards.txt file
# 
options_for_board()
{
    sed -n -e "s/^$3\.menu\.\([^\.]*\)\.\([^\.=]*\)=/\1=\2|/p" "$4"
}

##
# menu_names_from_options
#
# With stdin as the output from options_for_board(), print to stdout
# each option name.
#
menu_names_from_options()
{
    options=`cut -d= -f1 | uniq`
    echo ${options}
}

##
# is_valid_value_for_option
#
# Predicate
#
# true if $2 is a valid value for option $1, with options read from
# stdin
#
is_valid_value_for_option()
{
    grep -q "^$1=$2|"
}

##
# concat
#
# print to stdout $1 and $2 separated by a comma.  If $1 is empty,
# then no comma.
#
concat()
{
    if [ "x$1" = "x" ]; then
	echo "$2"
    else
	echo "$1,$2"
    fi
}

##
# option_specifier
#
# If the option-specifier given in $1 is valid, print a fully
# specified version of it to stdout.  So, if atmega328p is a valid
# selection for the cpu option, then print cpu=atmega328p
#
# Note that $1 may be a comma-separated list of options, in which case
# the output will also be comma separated and will show each validated
# option.
#
# $1    option-specifier from board-specifier
# $2    the board-specifier
#
option_specifier()
{
    local board_spec board_file options option_names option_values
    local option_spec option_specs matched spec_parts result i
    option_spec="$1"

    shift
    IFS=. read -a board_spec <<<"$@"

    board_file=`bfile_for_board "${board_spec[@]}"`
    options=`options_for_board "${board_spec[@]}" "${board_file}"`
    read -a option_names <<<`menu_names_from_options <<<"${options}"`
    IFS=, read -a option_specs <<<"${option_spec}"
    # Now we check each part of the option spec for validity.
    result=""
    for i in "${!option_specs[@]}"; do
	# If the option_spec part contains the option name, we will
	# use that, otherwise we will check based on position.
	IFS== read -a spec_parts <<<"${option_specs[i]}"
	matched=no
	if [ "x${spec_parts[1]}" = "x" ]; then
	    # No equal sign in spec_parts.
	    if is_valid_value_for_option "${option_names[i]}" \
	           "${option_specs[i]}" <<<"${options}"
	    then
		matched="yes"
		result=`concat "${result}" \
			       "${option_names[i]}=${option_specs[i]}"`
	    else
		break  # Failed to match, so abort with matched = no
	    fi
	else
	    if is_valid_value_for_option "${spec_parts[0]}" \
	           "${spec_parts[1]}" <<<"${options}"
	    then
		matched="yes"
		result=`concat "${result}" "${option_specs[i]}"`
	    else
		break  # Failed to match, so abort with matched = no
	    fi
	fi
    done
    if [ "${matched}" = "yes" ]; then
	echo "${result}"
    fi
}

##
# qualify_matches
#
# This takes the various matches identified by get_board_candidates()
# for each part of out board-specifier and validates them against the
# complete board-specifier.  This is harder than you might think as
# the board specifier may contain the vendor, and architecture, in
# addition to the board identfier, and may also have menu options
# provided.  This means that we cannot tell for sure, except in
# trivial cases, which parts of a board-specifier represent which
# part.  This function simply tries things out to remove matches that
# do not work.  If a board-specifier is sufficiently complete, there
# will only be a single output line from this function.
#
# $@ contains the board-specifier in the form of an array of its
# component parts.
# 
# Print, to stdout, only those entries, from stdin, that could be
# valid based on our board-specifier.
#
qualify_matches()
{
    local param_parts=("$@")
    local match match_parts
    local last_param_idx last_param
    local last_match_idx last_match
    local subqual qual
    sort -u |
	while read match; do
	    if [ "x${match}" = "x" ]; then
		continue
	    fi
	    IFS=. read -a match_parts <<<"${match}"
	    unset 'match_parts[3]' # In case we have options part provided
	    let last_param_idx=${#param_parts[@]}-1
	    let last_match_idx=${#match_parts[@]}-1
	    last_param="${param_parts[${last_param_idx}]}"
	    last_match="${match_parts[${last_match_idx}]}"
	    if [ "x${last_param}" != "x${last_match}" -a \
		 "x${last_match}" != "x*" -a \
	         "x${last_param_idx}" != "x0" ]; then
		# The last part of our board-specifier is different
		# from the last part of our candidate match, and the
		# candidate match does not end with "*".  This means
		# that we could have a board match followed by menu
		# options.  So, let's see if that's what's happening.
		subqual=`qualify_one "${match}" \
				     "${param_parts[@]: - 0:${last_param_idx}}"`
		if [ "x${subqual}" != "x" ]; then
		    # board-specifier without last part gives us a
		    # board match.  Check whether the last part
		    # provides valid options for this board.
		    qual=`option_specifier "${last_param}" "${subqual}"`
		    if [ "x${qual}" != "x" ]; then
			echo "${subqual}.${qual}"
			continue # This match is qualified.  Try the next
		    fi
		fi
	    fi
	    qualify_one "${match}" "$@"
	done
}

##
# has_single_match
#
# Predicate, returning true iff applying qualify_matches() to stdin
# and our parameters produces a single fully-qualified result line.
# Note that the matches provided in stdin might be for vendor or
# architecture only in which case they will contain "*" in the fincal
# position, and are not considered fully-qualified.
#
# $@ contains the board-specifier in the form of an array of its
# component parts.
#
has_single_match()
{
    local param_parts=("$@")
    local count=`qualify_matches "${param_parts[@]}" | grep -v '\*$' | wc -l`
    if [ "${count}" -ne "1" ]; then
	return 1
    fi
}

##
# list_boards
#
# For each result in qualified_matches, provide the fully qualified
# names of all matching boards, with 1 board per output line.
#
# $1 is our raw board-specifier
# 
# Expects all_boards, board_parts and qualified_matches to be defined.
#
list_boards()
{
    if [ "${#board_parts[@]}" = "0" ]; then
	# No board-specifier was provided, so list all boards
	echo "${all_boards}"
    else
	local list_matches=`(echo "${qualified_matches}" | grep "\*$") || \
      	    (echo "${qualified_matches}" | grep  "[^\*]$")`
	if [ "x${list_matches}" = "x" ]; then
	    error "No boards found matching \"$1\"."
	else
	    local expr
	    echo "${list_matches}" | \
		sed -e 's/^[^:]*://;s/^\([^\.]*\)/\1\\\\/' | \
		while read expr; do
		    echo "${all_boards}" | grep "${expr}$"
		done
	fi
    fi
}

##
# board_info
#
# The output of list boards is piped through this filter to provide more
# helpful output.  With $1 provided, menu options are identified.
#
# With large numbers of boards being listed this will be horribly
# inefficient: it should probably be re-implemented in gawk.
#
board_info()
{
    #echo "${board_paths}"
    local parts
    local path
    local name
    local option_line
    local options
    while IFS=. read -a parts; do
	path=`bfile_for_board "${parts[@]}"`
	name=`grep "^${parts[2]}\.name=" ${path} | cut -d= -f2-`
	printf "%-36s %s\n" "${parts[0]}.${parts[1]}.${parts[2]}:" "${name}"
	if [ "x$1" != "x" ]; then
	    options_for_board "${parts[@]}" "${path}" | \
		while read option_line; do
		    IFS="|" read -a options <<<"${option_line}"
		    printf "  %-36s %s\n" "${options[0]}" "${options[1]}"
		done
	fi
    done
}

##
# ensure_single_match
#
# Checks whether a fully qualified board name, provided in
# board_parts, matches only a single entry from qualified_matches.
# If so, the matching line will be printed, otherwise an appropriate
# error message will be printed to stderr, with nothing to stdout.
#
# Requires qualified_matches and board_parts array to be defined.
#
ensure_single_match()
{
    if [ "${#board_parts[@]}" = "0" ]; then
	error "No board-specifier provided"
    else
      	(echo "${qualified_matches}" | grep  "[^\*]$") | \
	    (
		local match
		local count=0
		local found
		while read match; do
		    if [ "x${match}" != "x" ]; then
			# We have a match
			let count++
			found=${match}
		    fi
		done
		if [ "x${count}" = "x0" ]; then
		    error "No boards matching \"$1\"."
		fi
		if [ "x${count}" != "x1" ]; then
		    error "Too many matches for \"$1\"." \
			  "\n  (try specifying vendor or architecture)."
		fi
		echo ${found}
	    )
    fi
}

##
# board_type
#
# Print an unambiguous board_type identifier.
# If board has options show warnings unless --nooptions has been
# specified.  If --full option is provided, provide the fully
# qualified version of the type.
#
# Requires qualified_matches, board_paths
#
board_type()
{
    local path options parts i 
    local board_id=`ensure_single_match "$1"`
    if [ "x${board_id}" = "x" ]; then
	exit 2
    fi
    IFS=. read -a parts <<<"${board_id}"
    if [ "${warn_of_options}" = "yes" ]; then
	path=`bfile_for_board "${parts[@]}"`
	
	if [ "x$1" != "x" ]; then
	    read -a options <<<`options_for_board "${parts[0]}" "${parts[1]}" \
	    			       "${parts[2]}" "${path}" |
		                    menu_names_from_options`
	    if [ "${#options[@]}" != "0" ]; then
		for i in "${!options[@]}"; do
		    if [[ "${parts[3]}" =~ ${options[${i}]} ]]; then
			# This option is specified in our
			# board-specifier
			options[$i]=""
		    fi
		done
		if [[ "${options[@]}" =~ [a-zA-Z] ]]; then
		    echo -e "\nNotice: this board can be further specified" \
			 "with the following -" 1>&2
		    echo -e "        options: " ${options[@]}"\n" 1>&2
		fi
	    fi
	fi
    fi
    if [ "${report_full_name}" = "yes" ]; then
	echo ${board_id}
    else
	# We want to print an abbreviated version of ${board_id}
	local options=""
	if [ "${#parts[@]}" = 4 ]; then
	    # Let's try to abbreviate the options.
	    local result
	    options=`sed -e 's/^[^=]*=//;s/,[^=]*=/,/g' <<<"${parts[3]}"`
	    result=`option_specifier "${options}" \
				     "${parts[0]}.${parts[1]}.${parts[2]}"`
	    if [ "x${result}" != "x${parts[3]}" ]; then
		# Cannot abbreviate the options, so reset the variable.
		options="${parts[3]}"
	    fi
	    if [ "x${options}" != "x" ]; then
		# prepend a dot
		options=".${options}"
	    fi
	fi
	# Now we'll see whether we can lose the vendor/architecture
	# parts.
	# Start with vendor.
	if has_single_match "${parts[1]}" "${parts[2]}" <<<"${all_matches}"
	then
	    # Try also removing vendor
	    if has_single_match "${parts[2]}" <<<"${all_matches}"; then
	    #if [ "x${matched}" != "x" ]; then
		echo "${parts[2]}${options}"
	    else
		echo "${parts[1]}.${parts[2]}${options}"
	    fi
	else	
	    # Apparantly we need the vendor.  Let's see if we
	    # can lose the architecture
	    if has_single_match "${parts[0]}" "${parts[2]}" <<<"${all_matches}"
	    then
		echo "${parts[0]}.${parts[2]}${options}"
	    else
		echo "${parts[0]}.${parts[1]}.${parts[2]}${options}"
	    fi
	fi
    fi
}

##
# projname
#
# Echo, to stdout, the project name.  This is the name of the project
# directory.
#
projname () {
    if dno_dirinfo | grep -q root; then
	basename `pwd`
    else 
	( cd ..; projname )
    fi
}

##
# parse_board_file
#
# Parses boards.txt files, printing only those details that match our
# board and selected menu options.  This results in a pretty small set
# of definitions that will later be fully parsed by parse_all_files().
#
parse_board_file()
{
    local parts
    IFS=. read -a parts <<<"$2"
    IFS=, read -a selections <<<"${parts[3]}"
    {
	xargs -n 1 <<<"${selections}"
	[ -f ./BOARD_INFO ] && cat BOARD_INFO
	echo "##END_SELECTIONS##"
    } | \
    gawk '
    BEGIN {
        reading_menu = 1
    }
    /^##END_SELECTIONS##/ {
        reading_menu = 0
    }
    (reading_menu) {
        # This is a menu selection entry.  We will record it
	menu_name = gensub(/^([^=]*)=.*/, "\\1", 1)
	selection = gensub(/^[^=]*=/, "", 1)
	menu_selections[menu_name] = selection
	print "menuselection." menu_name "=" menu_selections[menu_name]
    }
    /./ {
        if ($0 ~ "^" BOARD "\\.") {
	    # This line is for our selected board.
	    # Remove the board prefix
	    sub("^" BOARD "\\.", "")
	    if ($0 ~ "menu\\.") {
	        # This is a menu entry line
		print
		menu_name = gensub("^menu\\.([^\\.]*)\\..*", "\\1", 1)
		menu_option = gensub("^menu\\.[^\\.]*\\.([^\\.=]*).*", 
			    	   "\\1", 1)
		if ($0 ~ "^menu\\.[^\\.]*\\.[^\\.]*=") {
		    # This is a menu selection title
		    if (!(menu_name in menu_selections)) {
		        # This is the first option for an unchosen 
			# menu option.  This is the menu default
			menu_selections[menu_name] = menu_option  
			print "menuselection." menu_name "=" \
			          menu_selections[menu_name]
		    }
		    next # No more to do for this line
		}
		if (menu_option == menu_selections[menu_name]) {
		    print gensub("^menu." menu_name "." \
		   	         menu_selections[menu_name] ".", "", 1)
		}
	    }
	    else {
	        print gensub("^" BOARD "\\.", "", 1)
	    }
	}
    }
    ' VENDOR="${parts[0]}" ARCH="${parts[1]}" BOARD="${parts[2]}" - "$1"
}

##
# platform_files
#
# Identifies platform.txt and platform.local.txt files within the
# directories provided in $1 and $2.  If a file is found in $1, it
# will not be looked-for in $2.
#
# Each found file is printed as a full pathname to stdout.
#
# $1 is the directory that may contain the file
# $2 is a possible extra directory to search
#
platform_files()
{
    if [ -f "$1/platform.txt" ]; then
	echo "$1/platform.txt"
    elif [ -f "$2/platform.txt" ]; then 
	echo "$2/platform.txt"
    fi
    if [ -f "$1/platform.local.txt" ]; then
	echo "$1/platform.local.txt"
    elif [ -f "$2/platform.local.txt" ]; then 
	echo "$2/platform.local.txt"
    fi
}

##
# identfify_platform_files
#
# Print the set of platform files for parsing to stdout.  This is
# partly determined from any core references in our boards.txt file.
#
# $1 is board_file
# $2 is architecture
# stdin is board_defns
# board_paths is required
#
identify_platform_files()
{
    local refs platform 
    read -a refs <<<`sed -n -e '/=.*:/s/.*=\(.*\):[^:]*$/\1/p' | sort -u`
    for platform in "${refs[@]}"; do
	if ! [[ "${platform}" =~ ":" ]]; then
	    platform="${platform}:$2"
	fi
	platform_dir=`sed -n "/^${platform}/s/^[^:]*:[^:]*://p" \
			      		      <<<"${board_paths}"`
	platform_files `dirname "${platform_dir}"`
    done

    platform_files `dirname "$1"`
    
    # Finally, add any local platform.local.txt file.  This is a dno
    # extension that allows platform definitions to be overridden
    # locally.  The developer of dno does not buy in to the notion
    # that this is insecure.  Given that the user will create this
    # file in their own directory, and will add commands that they
    # could in any case run manually this seems pretty harmless.
    #
    if dno_dirinfo | grep -q root; then
	platform_files . | grep "platform.local.txt$"
    else 
	platform_files . .. | grep "platform.local.txt$"
    fi 
}

##
# arch_path
# Identify the arduino architecture directory from the platform path.
#
# Params:
#   $1 - the directory of the platform.txt file
#
# stdout:
#   The arduino arch path
# 
arch_path()
{
    # We may have a dir structure of hardware/arch/[version]/
    # or hardware/vendor/arch/[version]/, or version may be missing.
    if echo `basename "$1"` | grep -q "^[0-9\.]*$"; then
	dirname "$1"
    else
	# ...version may be missing
	echo $1
    fi
}

##
# hardware_path
#
# Identify the arduino hardware directory from the arch path.
#
# Params:
#   $1 - the arch path directory (as returned by the arch_path function)
#
# stdout:
#   The arduino arch path
#
hardware_path()
{
    dir=`dirname "$1"`
    if [ `basename "${dir}"` = "hardware" ]; then
	echo ${dir}
	return 0
    fi
    dir=`dirname "${dir}"`
    if [ `basename "${dir}"` = "hardware" ]; then
	echo ${dir}
	return 0
    fi
    echo "`basename $0`: Unable to identify hardware path" 1>&2
    return 1
}

## 
# parse_all_files
#
# Print, to stdout, a parsed version of all of the input files.  This
# converts the files into makfile syntax, and provides a few missing
# definitions.
#
# $1     - the path to the boards.txt file
# $2..$N - the various platform files
#
parse_all_files()
{
    boards_file="$1"
    shift
    local platform_path=`dirname $1`
    local arch_path=`arch_path ${platform_path}`

    gawk '
        # Record incoming input lines, identifying those that are
	# definitions and recording them separately.
	#
	function record_line(line,
			     lhs, rhs) {
	   lines[next_line] = line
	   next_line++
	   if (line ~ /[^#]*=/) {
	       # This is a definition line: record it so we can later
	       # expand our  definitions to help identify tool paths.
	       lhs = gensub(/^([^=]*).*/, "\\1", "1", line)
	       rhs = gensub(/^[^=]*=/, "", "1", line)
	       definitions[lhs] = rhs
	   }
	}

	# Modify entries of the form:
	#   tools.xyz.something={xxx.path}...
	# where xxx.path is not defined into:
	#   tools.xyz.something={tools.xyz.xxx.path}...
	#
	function update_tool_references(  idx, line, startpos, 
		 			  line_part, matchpos, rlength,
					  def, lhs, prefix) {
	    for (idx = 1; idx < next_line; idx++) {
	        line = lines[idx]
		if (line ~ /^tools\./) {
		    startpos = 1
		    line_part = substr(line,startpos)
	            while (matchpos = match(line_part, "{[^{}]*}")) {
		        rlength = RLENGTH
	                def = substr(line_part, matchpos + 1, rlength - 2)
			lhs = gensub(/^([^=]*).*/, "\\1", "1", line)
			if (!(def ~ /\.tools\./)) {
			    if (!(def in definitions)) {
			        # The current def appears to be
				# undefined and is not prefixed with
				# tools...  Lets see if prefixing it
				# will help.
			        prefix = gensub(/(tools.[^\.]*.).*/, 
				                "\\1", 1, lhs)
				if (prefix def in definitions) {
				    # Yep, it will.  So substitute it
				    # into our line.
				    sub("{" def "}","{" prefix def "}",\
				        lines[idx])
				    sub("{" def "}","{" prefix def "}",\
				        definitions[lhs])
				}
			    }
			}
			startpos += matchpos + length(def) + 1
		        line_part = substr(line,startpos)
		    }
		}
	    }
	}

	# Replace the substring in VALUE starting at FROM and of
	# length LEN, with the string WITH.
	#
	function replace_str(value, from, len, with) {
	   return substr(value, 1, from - 1) with substr(value, from + len)
	}

	# Expand the definition of DEF.  This replaces variables that
	# appear in the definition with their expanded values.  Any
	# variables that cannot be expanded get recorded as undefined,
	# and are replaced with a bracketed version: [def].
	# Additionally the array "used_in" is updated to show which
	# definitions are used in which other definitions.
	#
	function expand_definition(def,
				   matchpos, updated, rlength, rhs ) {
	    updated = 0
	    if (!(def in definitions)) {
	        undefined[def] = 1
		definitions[def] = "[" def "]"
		return definitions[def]
	    }
	    rhs = definitions[def]
	    # match the next (unembedded) variable definition
	    while (matchpos = match(rhs, "{[^{}]*}")) {
		rlength = RLENGTH
	        new_def = substr(rhs, matchpos + 1, rlength - 2)
		used_in[new_def][def] = 1
		new_value = expand_definition(new_def)
		rhs = replace_str(rhs, matchpos, rlength, new_value)
		updated = 1		
	    }
	    if (updated) {
	        definitions[def] = rhs
	    }
	    return rhs
       	}

	# Identify references that exist within our definitions that
	# are not currently defined.
	#
	function identify_undefined(def) {
	    for (def in definitions) {
	        expand_definition(def)
	    }
	}

	# Convert a line from platform.txt, etc, into a form suitable
	# for make.  This means converting "{ref}" into "$(ref)".
	#
	function makify(line) {
	    gsub(/{/, "$(", line)
	    gsub(/}/, ")", line)
	    return line
        }

	function print_recorded_lines(  idx) {
	   for (idx = 1; idx < next_line; idx++) {
	       print(makify(lines[idx]))
	   }
	}

	# Print a definition iff it is not already defined.
	#
	function print_undefined(name, value) {
	    if ((name in undefined) || !(name in definitions)) {
		print name " = " value
	        definitions[name] = value
		delete undefined[name]
	    }
	}

	function build_variant_path() {
	    return PLATFORM_PATH "/variants/" definitions["build.variant"] 
	}

	# Attempt to identify a file or sub-path from the path (def)
	# that is to be defined/discovered.  Eg if we have the
	# definition: something=[xyz.path]/a/wibble, then we will look
	# for a directory that contains the subpath a/wibble, and that
	# should be the directory for xyz.path.
	# Due to the vagaries of quoting (our definitions contain
	# quoted strings that themselves contain quoted strings, this
	# is slightly tricky.  The code that follows is not foolproof
	# but appears to work well enough.
	#
	function subpath_for(def, user_def) {
	   rhs = definitions[user_def]
	   after_def = gensub(".*\\[" def "\\]\"?", "", "1", rhs)

	   # If after_def ends in a quote that is not specific to an
	   # expanded definition, we eliminate that quote as it will
	   # confuse what follows. 
	   after_def = gensub(/([\) \t])"[ \t]*$/, "\\1", "1", after_def)
	   if (match(after_def, /^[^"]*"([^"]*"[^"]*")*[^"]*$/)) {
	       # There are an odd number of quotes in after_def.  Assume
	       # that the first quote matches something earlier in the
	       # string.  Deal with this by prepending a quote to
	       # after_def 
	       after_def = "\"" after_def
	   }
	   # Now eliminate anything after unquoted whitespace
	   after_def = gensub(/^((("[^"]*")|([^ \t"]*))*).*/, "\\1", "1", \
	                      after_def)
	   # And remove any remaining quotes
	   return gensub(/"/, "", "g", after_def)
	}

	# Add entries to array USES for all uses of DEF.
	#
	function all_uses_of(def, uses,
		             this) {
	    if (def in used_in) {
	    	for (this in used_in[def]) {
	            if (!(this in uses)) {
		       uses[this] = 1
		       all_uses_of(this, uses)
		    }
		}
	    }
	}
	# Attempt to determine paths for an undefined definition def.
	# We identify potential paths by calling our enclosing script
	# (dno_bpp) with the -x parameter.
	#
	function print_runtime_paths(def,
			       uses, subpath, subpaths, path, paths,
			       found_count, found_path) {
	    split("", uses)
	    all_uses_of(def, uses)
	    for (this in uses) {
		subpath = subpath_for(def, this)
		if (subpath && !(subpath ~ /\\/)) { # Ignore windows paths
		    subpaths[subpath] = 1
		}
	    }
	    for (subpath in subpaths) {
		while (THIS_SCRIPT " -x \"" base_search_path \
		       "\" \"" subpath "\"" | getline path > 0)
		{
		    paths[path]++
		    if (paths[path] >= found_count) {
		        found_count = paths[path]
			found_path = path
		    }
		}
	    }
	    if (found_path) {
	        for (path in paths) {
		    if (path == found_path) {
		        print def " = " path
		    }
		    else {
		        print "# " def " = " path 
		    }
		}
	    }
	}

	# Identify (discover) and print undefined required runtime paths
	# 
	function print_undefined_runtime_paths(  def) {
	    for (def in undefined)  {
	        if (def ~ /^runtime\..*\.path/) {
		    print_runtime_paths(def)
		}
	    }
	}

	BEGIN {
	    next_line = 1
	    split("", ossified) # Init the ossified array
	}
        (FNR == 1) {
	    filename =(FILENAME == "-")? STDIN_FILENAME: FILENAME
	    record_line("")
	    record_line("#")
	    record_line("# From file: " filename)
	    record_line("#")
	    record_line("")
	}
    	{
	    # OS-ify our entry.  This means replacing OS-specific
	    # entries for our OS with non-OS-specific entries and
	    # ensuring that original non-OS-specific entries do not
	    # subsequently appear.
	    defname_no_os = gensub(/^(.*)\.[^\.]*=.*/, "\\1", "1")
	    if (defname_no_os in ossified) {
	       record_line("# " $0)
	       next	        
	    }
	    if ($0 ~ "\\." OS "=") {
	       record_line("# " $0)
	       sub("\\." OS "=", "=")
	       lhs = gensub(/^([^=]*).*/, "\\1", "1")
	       ossified[lhs] = 1
	    }
    	}
	{
	    record_line($0)
	}
	END {
	    update_tool_references()
	    identify_undefined()
	    print_recorded_lines()
	    print_undefined("runtime.platform.path", PLATFORM_PATH)
	    print_undefined("runtime.hardware.path", HARDWARE_PATH)
	    print_undefined("build.arch", toupper(ARCH_NAME))
	    print_undefined("build.source.path", ".")
	    print_undefined("build.variant.path", build_variant_path())
	    print_undefined("runtime.ide.version", DNO_IDE_VERSION+0)
	    print_undefined("build.fqbn", "$(build.variant):$(build.core):"\
	    	  "$(build.target)$(build.menu_selections)")
	    base_search_path = gensub(/^"(.*)"$/, "\\1", "1",
	    		              definitions["runtime.hardware.path"])
	    base_search_path = gensub(/\/[^\/]*\/?$/, "", "1", base_search_path)
	    print_undefined_runtime_paths()
	    printf("\n")
        }
    ' OS="${HOST_OS}" \
	 PLATFORM_PATH="${platform_path}" \
	 HARDWARE_PATH=`hardware_path "${arch_path}"` \
	 ARCH_NAME=`basename "${arch_path}"` \
	 DNO_IDE_VERSION="${DNO_IDE_VERSION}" \
	 THIS_SCRIPT="$0" \
	 STDIN_FILENAME="${boards_file}" \
	 "$@" - # Note the last input is stdin
    return $?
}

##
# parse_config_files
#
# Identify the set of boards.txt and platforms.txt files that we need
# to parse and then parse them, with output to stydout.
#
# $1 our board-specifier.
#
parse_config_files()
{
    local parts board_defns platform_files file
    local board_id=`ensure_single_match "$1"`
    IFS=. read -a parts <<<"${board_id}"
    local board_file=`bfile_for_board "${parts[@]}"`
    board_defns=`parse_board_file "${board_file}" "${board_id}"`

    # Find any referenced platforms in board_defns
    platform_files=()
    while IFS='' read -r file; do
	platform_files+=("${file}")
    done <<<`identify_platform_files "${board_file}" \
    					    "${parts[1]}" <<<"${board_defns}"`


    # General header
    cat - <<EOF
# Parsed board info for ${board_id}
# generated `date "+%Y%m%d %H%M%S"`
#

BOARD_TYPE = ${board_id}
BOARD_FILE = ${board_file}

runtime.os = ${HOST_OS}
build.project_name = `projname`
EOF

    # Remove any referenced alternate core/variant/tool before passing
    # our filtered board definitions into our parser.
    #
    sed -e 's/=.*:/=/' <<<"${board_defns}" | \
        parse_all_files "${board_file}" "${platform_files}"

    return $?
}

##
# find_paths
#
#   $1 - directory from which to look for a file or directory
#   $2 - a file or directory to look for with $1
#
# stdout:
#   The full path for $2 within directory $1.
#
# Attempt to determine a file path to be added to our BOARD_INFO
# file.   This is called when this script is invoked with the -x
# option.  It will be called recursively from within our file_parser
# function. 
#
find_paths()
{
    {
	if [ -r "$1"/"$2" ]; then
	    echo "$1"/"$2"
	fi
	{
	    ls -1d "$1"/*/"$2"
	    ls -1d "$1"/*/*/"$2"
	    ls -1d "$1"/*/*/*/"$2"
	} 2>/dev/null | grep -v '\*'
    } |  sed -e "s!$2\$!!"
}


# Handle options.
#
# OTHER OPTIONS TO DO:
#   create data for BOARD_TYPE
#   create name for directory
#   parse for BOARD_INFO
#
action=identify
options=""
report_full_name=no
warn_of_options=yes
findpaths=no

while getopts "fhlnoptvx-:" opt; do
    case "${opt}" in
	-)
	    case "${OPTARG}" in
		full)
		    report_full_name=yes
		    ;;
		help)
		    usage
		    exit 0
		    ;;
		list)
		    action=list
		    ;;
		no* | no_options | no-options)
		    warn_of_options=no
		    ;;
		options)
		    options=options
		    ;;
		parse)
		    action=parse
		    ;;
		type)
		    action=type
		    ;;
		version)
		    version
		    exit 0
		    ;;
		*)
		    if [ "$OPTERR" = 1 ] && [ "${optspec:0:1}" != ":" ]; then
                        echo "`basename $0`: Unknown option --${OPTARG}" 1>&2
			echo ARGS: "$@" 1>&2
			exit 2
                    fi
		    ;;
	    esac
	    ;;
	f)
	    report_full_name=yes
	    ;;
	h)
	    usage
	    exit 0
	    ;;
	l)
	    action=list
	    ;;
	n)
	    warn_of_options=no
	    ;;
	o)
	    options=options
	    ;;
	p)
	    action=parse
	    ;;
	t)
	    action=type
	    ;;
	v)
	    version
	    exit 0
	    ;;
	x)  findpaths=yes
	    ;;
	*)
	    echo "`basename $0`: Unexpected option: -${OPTARG}" 1>&2
			echo ARGS: "$@" 1>&2
	    exit 1
	    ;;
    esac
done
shift $((OPTIND-1))

if [ "${findpaths}" = "yes" ]; then
    # Run in path "finder" mode.  This is called recursively from
    # parse_all_finds()
    #
    if [ "d$1" != "d" -a -d "$1" ]; then
	find_paths "$1" "$2"
	exit $?
    else
	echo "`basename $0`: \"$1\" is not a directory" 1>&2
	exit 1
    fi
fi

# Get our board information
#
board_paths=`all_board_paths`
all_boards=`all_boards`

# Read board-specifier, $1, into the board_parts array. 
#
IFS=. read -a board_parts <<<"$1"

#echo "BOARD_PARTS" ${#board_parts[@]} ${board_parts[@]}

# Our board will be fully specified within the first three parameters,
# so let's identify some candidate matches.
#
all_matches=`(get_board_candidates "${board_parts[0]}"
	      get_board_candidates "${board_parts[1]}"
              get_board_candidates "${board_parts[2]}")`
#echo ALL MATCHES: "${all_matches}"

# Filter out those candidates that do not match the board-specifier
#
qualified_matches=`echo "${all_matches}" | qualify_matches "${board_parts[@]}"`

#echo "QUALIFIED MATCHES:" "${qualified_matches}"

case "${action}" in
    "list")
	list_boards "$1" | board_info ${options}
	;;
    "identify")
	ensure_single_match "$1"
	;;
    "parse")
	parse_config_files "$1"
	;;
    "type")
	board_type "$1"
	;;
esac

