#! /usr/bin/env -S perl -nw
#
#       dno_checksize - check Arduino images sizes for dno
# 
#       Copyright (c) 2026 Marc Munro
#       Author:  Marc Munro
# 	License: GPL-3.0
#
# Usage:
# dno_checksize <program size regexp> <data size regexp> \
#               <max program size> <max data size> 
#
# Reads from stdin, calculating the program and data sizes based on
# the provided regexp parameters.  Prints informational result and
# returns failure if either size is too large.
#

BEGIN {
    $program_regexp = shift;
    $data_regexp = shift;
    $pmax = shift;
    $dmax = shift;
    $dsum = 0;
    $psum = 0;
}
/$program_regexp/ and $psum += $1;
/$data_regexp/ and $dsum += $1;
END {
    printf("Program size: %6d out of %-6d (%d%%: %d remaining)\n",
	   $psum, $pmax, (100*$psum)/$pmax, $pmax - $psum);
    printf("   Data size: %6d out of %-6d (%d%%: %d remaining)\n",
	   $dsum, $dmax, (100*$dsum)/$dmax, $dmax - $dsum);
    if (($psum > $pmax) || ($dsum > $dmax)) {
    	print STDERR "EXECUTABLE TOO LARGE\n";
	exit 2
    }
}


# Local Variables:
# mode: perl
# End:
