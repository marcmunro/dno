#! /usr/bin/make -f 
#  dno
# 
#       Self-executing makefile for dno, the Arduino build system
#	Execute "dno help" or "dno info" for more information.
# 
#       Copyright (c) 2024, 2025, 2026 Marc Munro
#       Author:  Marc Munro
# 	License: GPL-3.0
#  
#

# Version and configuration stuff
#
DNO_VERSION = @DNO_VERSION@
EXTRA_BOARDS_FILE=@DNO_EXTRA_BOARDS_FILE@

# Do not use make's built-in rules
# (this improves performance and avoids hard-to-debug behaviour).
#
MAKEFLAGS += -r

# We need bash rather than sh so we can use the pipefail option.
#
SHELL = bash

# Define dno helper commands.
#
BPP = $(BINDIR)/dno_bpp
MENU = $(BINDIR)/dno_menu


###########
# Configuration values
# You might want to change these, specify them on the command line or
# in an included makefile.

# Everything will be built in and below the following directory.
#
BUILD_DIR = build


###########
# Feedback controls.
#
# Define VERBOSE on the command line to show the full compilation, etc
# commands.
#
# Define REPORT to cause each target to be reported upon.  This is
# automatically done when VERBOSE is defined.
#
# Define SHOW_RULES to show the generation of automatically created rules.
#
# Define DEBUG to show the calculated values of key variables.  This can be Y,
# Yes, or a regexp to match only the variables we want.
#
# Define QUIET to cause image size an upload information to not be shown
#

# If VERBOSE is defined $(FEEDBACK) will do nothing and $(AT) will have no
# effect, otherwise $(FEEDBACK) will perform an echo and $(AT) will make the
# command that follows it execute quietly.  Setting VERBOSE to N will
# cause it to become undefined.  This allows us to explicitly unset
# VERBOSITY for certain recursive calls.
#
# FEEDBACK_ECHO may be used in multi-line shell commands where part of the
# command can usefully provide feedback.
#
override undefine verbose
ifdef VERBOSE
  ifeq "$(VERBOSE)" "N"
    override undefine VERBOSE
    override undefine DEBUG
    override undefine REPORT
  endif
endif

ifdef VERBOSE
  FEEDBACK = @true
  FEEDBACK_ECHO = echo " "
  AT =
  REPORT = true
  verbose=y
else
  FEEDBACK = @echo " "
  FEEDBACK_ECHO = true
  AT = @
endif

# Define a hash character.  This can be used to comment out parts of
# an action in a recipe.
#
override undefine HASH
define HASH
#
endef

ifdef QUIET
  # This prevents anything following $(IFNOTQUIET) from being executed
  IFNOTQUIET = $(HASH)
  verbose=n
endif

# TARGET echoes the current target when REPORT is defined.
# depending on whethere $(COMMANDS) contains anything.
#
override undefine TARGET COND_TARGET
ifdef REPORT
  TARGET_STR = BUILDING TARGET[$(MAKE_RESTARTS)]
  TARGET = @echo $(TARGET_STR) $@
else
  TARGET = @$(HASH)
endif

# If SHOW_RULES is defined feedback will be provided from the recursive rule
# building macros.  This is intended for debugging dno.
#
ifdef SHOW_RULES
  override undefine feedback
  feedback = $(info $1)
endif

# If DEBUG is defined, we can show the values of certain defined variables:
# those that are followed by calls to $(call debug) within this file.  DEBUG
# may be given the value Y, YES or ALL to show all such instrumented variables,
# or may be a (grep) regexp that matches the names of only those variables we 
# are interested in.
#
override undefine DBG
override undefine debug
ifdef DEBUG
  debug = $(if $(shell echo $(DEBUG) | grep -i "^\(y\|yes\|all\)$$"),\
	    $(info DBG: $1 = $($1)),\
	    $(if $(shell echo $1 | grep "$(DEBUG)"), $(info DBG: $1 = $($1))))
  DBG = @echo DBG: 
else
  DBG = @true
endif

# Pass relevant verbosity variables to any recursive make
#
export DEBUG VERBOSE FEEDBACK


###########
# General definitions
#

# Figure out the path to this makefile, and ensure recursive makes use it.
#
MAKEFILEPATH := $(realpath $(call lastword,$(MAKEFILE_LIST)))
THIS_MAKEFILE := $(firstword $(MAKEFILE_LIST))
BINDIR := $(realpath $(dir $(MAKEFILEPATH)))
REAL_MAKE := $(MAKE)
MAKE := $(THIS_MAKEFILE)


###########
# Helper macros and related definitions.
#

# empty definition.  Needed by the succeeding definition for "space".
#
override undefine empty
empty :=

# An explicit space definition for use in macros.  Generally, macros eliminate
# leading spaces.  Using this definition prevents that.
#
override undefine space
space := $(empty) $(empty)

##
# is_std_lib:
# $1 is considered a library if it contains a .h file with the same
# stem as the directory name.  Result is $1 if it is a standard lib.
#
override undefine is_std_lib
is_std_lib = $(and $(wildcard $(1)/$(notdir $(1)).h), $(1))

##
# is_special_lib
# $1 is considered a special lib, if it contains a src dir containing
# a header with the same stem as the directory name.  Result is $1 if
# it is a special lib. 
#
override undefine is_special_lib
is_special_lib = $(and $(wildcard $(1)/src/$(notdir $(1)).h), $(1)/src)

##
# is_lib
# Check each dir in $1 to see if it is either a std lib or special
# lib.  Result will be each entry from $1 that is either a standard
# or special lib.  Note that bootloader (boot) directories are a
# special case as they may look like lib dirs but are not. 
#
override undefine is_lib
is_lib = $(foreach lib,$(1), \
	     $(if $(call eq,$(notdir $(lib)),boot),, \
	       $(or $(call is_std_lib,$(lib)), \
		    $(call is_special_lib,$(lib)))))

##
# is_board_dir
# Check each dir in $1 to see if it is a board directory.  
#
override undefine is_board_dir
is_board_dir = $(foreach dir,$(1), \
		 $(and $(or $(wildcard $(dir)/BOARD_INFO), \
			    $(wildcard $(dir)/BOARD_TYPE), \
			    $(shell $(BPP) -q -t $(notdir $(dir)))), \
		       $(dir)))

##
# deplibs
# $1 - path of library root
# $2 - list of dependency files
# Return libraries referenced in $2 that can be found in the directory $1
#
override undefine deplibs
deplibs = $(sort \
            $(foreach lib, \
	      $(sort \
	        $(strip \
		  $(shell grep -sh "^ *.*$(notdir $(1))/" \
		                   $2 /dev/null))),\
	        $(if $(filter $(realpath $(dir $(lib))), $(realpath $(1))),\
	          $(1))))

##
# unbuilt_deps
#   $1 - list of dependency files.  These may or may not have been
#        already generated.
# Return the list of dependency files (from $1) that do not currently
# exist.
#
override undefine unbuilt_deps
unbuilt_deps = $(foreach dep,$1,$(if $(wildcard $(dep)),,$(dep)))

##
# libname
# Return the library name from a directory path that may include a src
# subdir. 
#
override undefine libname
libname = $(notdir $(subst /src,,$(patsubst %/,%,$1)))

##
# filepart
# Functionally equivalent to notdir builtin that can be executed using
# $(call...
# This makes it usable as a filter transform function for uniqify.
# $1 - relative or absolute pathname of file.
#
override undefine filepart
filepart = $(notdir $(strip $1))

##
# eq
# Boolean.  Returns value if $1 and $2 are equal
# 
override undefine eq
eq = $(and $(findstring $(strip $1),$(strip $2)),\
	   $(findstring $(strip $2),$(strip $1)))

##
# not
# Boolean "not" function.
#
override undefine not
not = $(if $(strip $1),,t)

##
# apply
# Apply a filter transform function to $1
# $1 - value to possibly be operated on
# $2 - the name of a filter transform function (or empty) that will be
#      applied to $1.  If this is empty $1 is returned verbatim.
#
override undefine apply
apply = $(if $2,$(call $2,$1),$1)

##
# match
# Boolean.  Returns a value if $3 applied to $2 matches $1.
# $1 - value to be checked against
# $2 - raw value to be transformed before checking against $1
# $3 - filter transform function to be applied to $2 before it is
#      checked for equality with $1
#
override undefine match
match = $(and $(call eq,$(call apply,$1,$3),$(call apply,$2,$3)),t)

##
# rest
# Return all but the first word from $1
#
override undefine rest
rest = $(strip $(wordlist 2,99999,$1))

##
# remove
# Remove items matching the singular $1 from the list $2
# $1 - match.  Items matching this will be removed from $2
# $2 - wordlist.
# $3 - filter transform function.  Each word in $2 will be transformed
#      using this function before being checked for a match with $1
#
override undefine remove
remove = $(strip \
	   $(if $(strip $2), \
	     $(if $(call match,$1,$(firstword $2),$3),,$(firstword $2)) \
	     $(call remove,$1,$(call rest,$2),$3)))

##
# minus
#   $1 list of things
#   $2 another list of things
# Result is the set of things in $1 that do not appear in $2.
#
override undefine minus
minus = $(if $2,\
	     $(call remove,$(firstword $2),\
		           $(call minus,$1,$(call rest,$2),$3),$3),\
	   $1)

##
# uniqify
# Remove duplicate matches from a list.
#   $1 - list of words
#   $2 - filter transform (match) function
#
# If a list contains something like path1/lib1 path2/lib2 path3/lib1
# and the "filepart" filter tranform function is used, the second lib1
# reference will be removed from the list.
#
override undefine uniqify
uniqify = $(if $(strip $1),\
	      $(firstword $1)\
	      $(call uniqify,\
		$(call remove,$(firstword $1),$(call rest,$1),$2),$2))

##
# matching_files
#   $1 Set of patterns to match for
#   $2 Set of directories within which matches may be found
# Return a list of files matching a set of patterns ($1) from a set of
# directories ($2). 
#
override undefine matching_files
matching_files = $(foreach pattern, $(1),\
	            $(foreach dir, $(2),\
	               $(wildcard $(dir)/$(pattern))))
##
# to_objects
#   $1 Target directory
#   $2 Set of source file names.
# Translate source file names into object file paths.  The object
# files will all be placed in the given target directory.
#
override undefine to_objects
to_objects = $(filter-out $(ignore_objects), $(patsubst %.ino, $(1)/%.ino.o,\
		 $(patsubst %.S, $(1)/%.S.o,\
		   $(patsubst %.c, $(1)/%.o,\
                     $(patsubst %.cpp, $(1)/%.o, $(notdir $(2)))))))

##
# RECURSE_FOR_SUBDIRECTORIES
# This macro is to be placed into a recipe to cause dno to run
# recursively in subdirectories.  It is intended for the "clean" and related
# targets.
#
override undefine RECURSE_FOR_SUBDIRS
define RECURSE_FOR_SUBDIRS
	find . -mindepth 1 -maxdepth 1 -type d ! -name html | \
	  while read dir; do \
	    if [ "`basename $${dir}`" != ".git" ]; then \
	      ( cd $${dir}; \
	        $(MAKE) --no-print-directory -j1 \
		    DNO_STARTDIR=$(DNO_STARTDIR) $@); \
	    fi; \
	  done
endef

##
# normalise_dirname
#   $1 - A directory name which may or may not be terminated with a
#        slash ('/') character
# Return the directory name definitely terminated with a single slash.
#
override undefine normalise_dirname
normalise_dirname = $(strip $(subst //,/,$1/))

##
# sketch_files
#   $1 - list of compiled (object or dep) files, some of which may be
#        lib files, corelib files or sketch files.
# Return only the files that are directly part of the sketch.  Since
# other files will be compiled into target directories below
# BUILD_DIR, we can identify sketch files as those that are compiled
# directly into BIULD_DIR.
#
override undefine sketch_files
sketch_files = $(strip \
		 $(foreach path,$1,\
	           $(if $(call eq,$(call normalise_dirname,$(dir $(path))),\
				  $(call normalise_dirname,$(BUILD_DIR))),\
		       $(path))))

##
# lib_files
#   $1 - list of compiled (object or dep) files, some of which may be
#        lib files or sketch files.
# Return only the files that are lib files.  In order to identify lib
# files only and not corelib files, $1 should not contain corelib files.
#
override undefine lib_files
lib_files = $(strip $(call minus,$1,$(call sketch_files,$1)))

##
# core_files
#   $1 - list of compiled (object or dep) files, some of which may be
#        lib files or sketch files.
# Return only the files that are corelib files. 
#
override undefine core_files
core_files = $(strip \
		 $(foreach path,$1,\
	           $(if $(call eq,$(call normalise_dirname,$(dir $(path))),\
				  $(call normalise_dirname,\
				         $(BUILD_DIR)/libcore)),\
		       $(path))))

##
# requote
# Helper macro to requote lines coming from BOARD_INFO (and friends).
# Any quotes that appear to be within words get escaped.  Others are
# left as they are.  This makes most recipes coming from BOARD_INFO
# work.  How they work in the Arduino ide is a mystery as the quoting
# in platform.txt seems very eccentric in places.
#
override undefine requote
requote = $(shell echo '$1' | dno_requote) 

##
# indent
# This indents command output to help make it more readable.
#
override undefine indent
indent = set -o pipefail; ($1) | sed -e 's/^/    /'

##
# proj_ino
# Expands to <dir>/<projname>.ino for the directory for files in $1 and
# <projname> in $2.
#
proj_ino = $(if $1, $(dir $(firstword $1))$2.ino)

##
# dup_wts
#   $1 - list of targets
# Duplicate each entry, adding a trailing slash to the dupe.  This
# allows directory names to be provided as targets with or without the
# trailing slash. 
#
override undefine dup_wts
dup_wts = $(foreach dir,$1,$(dir) $(dir)/) 

##
# SETVERBOSE
# $1 is action (purpose)
# Set the verbosity for action $1, based on the verbose, which is a
# proxy for the the VERBOSE variable.  The result of this call should
# be evaled.
#
define SETVERBOSE
$(if $(call eq,$(verbose),y), \
  $1.verbose=$(tools.$($1.tool).$1.params.verbose), \
  $(if $(call eq,$(verbose),n), \
    $1.verbose=$(tools.$($1.tool).$1.params.quiet)))

endef

##
# CONFIRM
# $1 Prompt
# $2 Bailout message (optional)
# Shell commands requiring the user to respond with a confirmation in
# order to continue.
#
define CONFIRM
    read -p "$1? " -n 1 -r; \
    echo; \
    if [[ $${REPLY} =~ ^[Yy]$$ ]]; then true; \
    else $(and $2,echo "$2";) false; fi

endef

##
# SETBAUD
# Set MONITOR_BAUD based on its current value, or whatever can be
# found that looks like a baud rate setting the source files, or 9600.
#
define SETBAUD
  $(eval MONITOR_BAUD:=$(or $(MONITOR_BAUD), \
	         $(shell grep --no-filename --only-matching \
			      "$(SPEED_REGEXP)" $(USER_SOURCES) /dev/null | \
			 sed -e 's/[^0-9]*\([0-9][0-9]*\).*/\1/' | \
			 sort | head -1), \
		 9600))
endef

##
# QFILES
# Quote each valid filename.
#
define QFILES
  $(foreach file,$1,$(and $(wildcard $(file)),"$(file)"))
endef

# DNO_STARTDIR is set when we are recursing for one of the clean targets.
# In these cases we just want to get started as quickly as possible,
# so we avoid much of the slow startup bahaviour.
#
ifdef DNO_STARTDIR
  QUICKSTART = true
endif

ifndef QUICKSTART

################################################################
# Figure out from where we are being run.
#
# dno_dirinfo is used to determine where we are in an Arduino development
# directory system.
#
# Generally, the default target will depend on where we are.  If we are in a
# code directory, the default target will build the code.  If in a lib or unit
# test directory, it will build and run unit tests.  If in a docs directory,
# it will build docs.
#

# A local dno.mk file can be used to override or redefine certain
# variables.  In particular DIR_TYPE can be defined rather than
# allowing it to be dynamically discovered.  Bootloader builds require
# an external build command to be run.  By default this will be make,
# but dno.mk can redefine BOOT_BUILDER to be something else.
# DEFAULT_BOOT_TARGET may also be redefined.
#
# BOOT_BUILDER runs make with MAKEFLAGS removed from env
#
BOOT_BUILDER  = env -u MAKEFLAGS $(REAL_MAKE) $(BOOT_TARGET) \
	       --no-print-directory
DEFAULT_BOOT_TARGET = default_boot_target
BURN_DEPS = $(DEFAULT_BOOT_TARGET)
BOOTLOADER_IMAGE =`ls -1t *hex *bin 2>/dev/null | head -1`
-include dno.mk

$(call debug,BOOT_BUILDER)
$(call debug,BOOT_TARGET)
$(call debug,DEFAULT_BOOT_TARGET)
$(call debug,BURN_DEPS)
$(call debug,BOOTLOADER_IMAGE)

ifndef DIR_TYPE
  DIR_TYPE := $(shell $(BINDIR)/dno_dirinfo)
endif

DEFAULT_BUILD_TYPE = unknown
BOARD_DIR = .

# Define some fundamental variables based on the type of our directory tree
# and whether targets have been explicitly specified.
#
ifeq "$(findstring _board, $(DIR_TYPE))" "_board"
  DEFAULT_BUILD_TYPE = build
  BOARD_DIR = .
  ifeq "$(DIR_TYPE)" "sub_board"
    PROJDIR = ..
    SRC_DIRS = . ..
    USER_LIB_ROOTS = . ..
  else
    PROJDIR = .
    SRC_DIRS = .
    USER_LIB_ROOTS = .
  endif
else ifeq "$(DIR_TYPE)" "root_code"
  DEFAULT_BUILD_TYPE = root_code_info
  BOARD_DIR = .
  PROJDIR = .
  USER_LIB_ROOTS = .
else ifeq "$(DIR_TYPE)" "root"
  DEFAULT_BUILD_TYPE = root_build_info
  PROJDIR = .
  BOARD_DIR = .
  USER_LIB_ROOTS = .
else ifeq "$(DIR_TYPE)" "test"
  DEFAULT_BUILD_TYPE = unit_test
  PARENT = $(shell $(BINDIR)/dno_dirinfo ..)
  ifeq "$(PARENT)" "lib"
    TEST_LIB = $(notdir $(realpath ..))
    $(call debug,TEST_LIB)
    TEST_LIB_DIR = ../../$(TEST_LIB)
    TEST_CODE_DIR = .
    GPARENT = $(shell $(BINDIR)/dno_dirinfo ../..)
    ifeq "$(findstring root, $(GPARENT))" "root"
      PROJDIR = ../..
      USER_LIB_ROOTS = ../.. 
    else
      PROJDIR = ../../..
      USER_LIB_ROOTS = ../.. ../../.. 
    endif
  else
    $(error Not in a suitable dno directory.)
  endif
else ifeq "$(DIR_TYPE)" "lib"
  DEFAULT_BUILD_TYPE = lib
  ifeq "$(shell $(BINDIR)/dno_dirinfo .. |  sed -e 's/root.*/root/')" "root"
    PROJDIR = ..
  else
    ifeq "$(shell $(BINDIR)/dno_dirinfo ../.. | sed -e 's/root.*/root/')" "root"
      PROJDIR = ../..
    else
      $(error CANNOT DETERMINE TYPE OF DIRECTORY)
    endif
  endif
else ifeq "$(DIR_TYPE)" "boot"
  DEFAULT_BUILD_TYPE = boot
  ifeq "$(shell $(BINDIR)/dno_dirinfo .. | sed -e 's/root.*/root/')" "root"
    PROJDIR = ..
  else
    ifeq "$(shell $(BINDIR)/dno_dirinfo ../.. | sed -e 's/root.*/root/')" "root"
      PROJDIR = ../..
    else
      $(error CANNOT DETERMINE TYPE OF DIRECTORY)
    endif
  endif
else ifeq "$(DIR_TYPE)" "docs"
  DEFAULT_BUILD_TYPE = docs
else
  BOARD_DIR = .
endif

DOING_DOCS_BUILD = $(and $(filter $(MAKECMDGOALS),docs/html),t)
$(call debug,DOING_DOCS_BUILD)

PROJDIR := $(abspath $(PROJDIR))

$(call debug,BOARD_DIR)
$(call debug,DEFAULT_BUILD_TYPE)
$(call debug,PROJDIR)
$(call debug,DIR_TYPE)
$(call debug,BUILD_DIR)
$(call debug,SRC_DIRS)

ifndef DNO_STARTDIR
  DNO_STARTDIR = $(CURDIR)
endif

$(call debug,DNO_STARTDIR)

# Classify our targets.
# This enables us to avoid unnecessary overhead.  In particular, if we
# are only building one of the NO_BUILD_TARGETS, we do not want to
# include any deps files as that will potentially require
# recompilations.
#
NO_BUILD_TARGETS = clean tidy pristine extraclean \
		   do_clean do_tidy do_pristine \
		   list info help show_boards check_extra_boards \
		   BOARD_TYPE BOARD_INFO dno_board_type \
		   ../BOARD_INFO docs docs/html boot burn \
		   devices check_device_path reset \
		   monitor cat no_screen no-screen noscreen \
		   show-programmers list-programmers listp \
		   PROGRAMMER unknown

UNIT_TEST_TARGETS = unit_test test tests unit

# Determine whether we are doing any cross-builds or any local builds.
# A cross-build is the normal operation of dno.  It creates objects
# and executables for a specific board.  A local build is done when we
# are compiling and running unit tests directly on the host machine.
# If we are doing neither, we can cut out a lot of work.

ifneq "$(DIR_TYPE)" "unknown"
  ROOT_DIRS := $(shell find $(PROJDIR) -maxdepth 1 -type d)
  LIB_DIRS := $(call dup_wts,$(notdir $(call is_lib, $(ROOT_DIRS))))
  BOARD_DIRS := $(call dup_wts,$(notdir $(call is_board_dir, $(ROOT_DIRS))))
  $(call debug,ROOT_DIRS)
  $(call debug,LIB_DIRS)
  $(call debug,BOARD_DIRS)

  IN_BOARD_DIR := $(and $(filter root_board sub_board,$(DIR_TYPE)),t)
  ifeq "$(DIR_TYPE)" "boot"
    # The only thing we can do in this dir is a boot (or docs) build, so don't
    # check for anything else.
  else
    ifeq "$(DIR_TYPE)" "test"
      HAVE_TEST_MAKEFILE = $(or $(wildcard Makefile), \
			        $(wildcard makefile), \
			        $(wildcard GNUMakefile))
    endif
    ifeq "$(HAVE_TEST_MAKEFILE)" ""

      ifeq "$(MAKECMDGOALS)" ""
        HAVE_CROSS_BUILD_TARGETS := $(IN_BOARD_DIR)
        HAVE_TEST_TARGETS := \
	  $(and $(filter test test_container,$(DIR_TYPE)),t)
      else
        # We have explicit targets.  Determine whether any of them require
        # us to do cross-builds or local builds.

        HAVE_CROSS_BUILD_TARGETS := \
	   $(and $(strip \
		   $(call minus,$(MAKECMDGOALS),\
	                        $(NO_BUILD_TARGETS) $(UNIT_TEST_TARGETS) \
				$(LIB_DIRS) $(BOARD_DIRS))),t)
        HAVE_TEST_TARGETS := \
	   $(call not,$(call minus,$(MAKECMDGOALS),$(UNIT_TEST_TARGETS)))
      endif
    endif
  endif
endif


HAVE_BUILD_TARGETS := $(and $(or $(HAVE_TEST_TARGETS),\
			          $(HAVE_CROSS_BUILD_TARGETS)), \
			    $(call not $(HAVE_TEST_MAKEFILE)))

$(call debug,HAVE_CROSS_BUILD_TARGETS)
$(call debug,HAVE_TEST_TARGETS)
$(call debug,HAVE_BUILD_TARGETS)
$(call debug,PROJDIR)


################################################################
# Default target
# This must appear before any other targets.  The value of DEFAULT_BUILD_TYPE
# is determined by the type of directory in which we are called.
#
.PHONY: unknown
$(DEFAULT_BUILD_TYPE):


ifeq "$(HAVE_TEST_TARGETS)" "t"
  ################################################################
  # Callable build rule generators for native builds
  # These are only used if are building unit tests.

  ##
  # Compilation rules for unit test compilations.  This creates the rules for
  # compiling cpp, c and S files.
  #
  # $1 is the target directory for objects
  # $2 is the source directory
  # $3 is the optional lib name
  #
  define NATIVE_COMPILE_RULE
  $(1)/%.o $(1)/%.d &: $(2)/%.cpp
	$$(TARGET)
	@mkdir -p $$(dir $$@)
	$(FEEDBACK)  C++ $(if $3,[$3]) $$(notdir $$<)
	$(AT) $$(CXX) $$(CXXFLAGS) -c -MMD $$< -o $$(@:.d=.o)
  $(1)/%.o $(1)/%.d &: $(2)/%.c
	$$(TARGET)
	@mkdir -p $$(dir $$@)
	$(AT) $$(CC) $$(CFLAGS) -c -MMD $$< -o $$(@:.d=.o)
	false
  $(1)/%.S.o $(1)/%.S.d &: $(2)/%.S
	$$(TARGET)
	@mkdir -p $$(dir $$@)
	$(FEEDBACK)  NOT IMPLEMENTED: AS $$<
	false

  endef
endif

ifeq "$(HAVE_CROSS_BUILD_TARGETS)" "t"
  ################################################################
  # Deal with recipe hooks.  SeeL
  #     https://docs.arduino.cc/arduino-cli/platform-specification/
  #
  # NOTE: sketch_prebuild must precede libraries discovery!  We should
  # be able to handle this by making it an included makefile which
  # can be included before library discovery.

  ##
  # Generate a target name from a recipe hook name.
  # If the recipe hook name has 2 parts, an abbreviated form of the
  # name will be returned consisting of pre or post (derived from the
  # second part) followed by the, possibly abbreviated, fist part.
  # So, sketch.prebuild becomes presketch.
  #
  define RECIPE_HOOK_NAME
    $(if $(call eq,$(firstword $(subst ., ,$1)),\
		   $(lastword $(subst ., ,$1))),\
	$1,\
	$(patsubst post%,post,$(patsubst pre%,pre,\
		   $(lastword
		     $(subst ., ,$1))))$(patsubst lib%,lib,
						  $(patsubst link%,link,
				$(firstword $(subst ., ,$1)))))

  endef

  ##
  # Create a target for a recipe hook.
  #   $1 Name of recipe hook in BOARD_INFO, eg sketch.prebuild
  #   $2 Name of hook for dno
  #
  define RECIPE_HOOK_TARGET
    RH_$(strip $2)_COMMANDS = $(shell dno_commands_for $1)
    RH_$(strip $2)_TARGET = build/.$(strip $2)
    build/.$(strip $2):
	$$(TARGET)
	$$(FEEDBACK) Performing $(strip $2)...
	$$(AT) set -e; $$(RH_$(strip $2)_COMMANDS)
	$$(AT) touch $$@

  endef

  $(foreach targ,$(shell dno_commands_for -l),\
     $(eval $(call RECIPE_HOOK_TARGET,$(targ),\
	$(call RECIPE_HOOK_NAME,$(targ)))))

  ifneq "" "$(RH_prebuild_TARGET)"
    $(RH_prebuild_TARGET): BOARD_INFO
  endif

  ifneq "" "$(RH_presketch_TARGET)"
    $(RH_presketch_TARGET): BOARD_INFO $(RH_prebuild_TARGET)
  endif

  ifneq "" "$(RH_postlib_TARGET)"
    $(RH_postlib_TARGET): $(lib_objects)
  endif

  ifneq "" "$(RH_postcore_TARGET)"
    $(RH_postcore_TARGET): $(archive_file)
  endif

  $(call debug,RH_prebuild_TARGET)
  $(call debug,RH_prebuild_COMMANDS)
  $(call debug,RH_presketch_TARGET)
  $(call debug,RH_presketch_COMMANDS)
  $(call debug,RH_postsketch_TARGET)
  $(call debug,RH_postsketch_COMMANDS)
  $(call debug,RH_precore_TARGET)
  $(call debug,RH_precore_COMMANDS)
  $(call debug,RH_postcore_TARGET)
  $(call debug,RH_postcore_COMMANDS)
  $(call debug,RH_preobjcopy_TARGET)
  $(call debug,RH_preobjcopy_COMMANDS)
  $(call debug,RH_postobjcopy_TARGET)
  $(call debug,RH_postobjcopy_COMMANDS)

  # Eval'able rule definition for compiling C++, C, INO and ASM sources
  # for different arduino-like boards.
  # $1 is the path to the object file.
  # $2 is the path to the source file.
  # $3 is a short printable version  of $2, for feedback.
  # $4 is a dependency provider function
  # Note that the actual compilation commands are performed by
  # attempts to rebuild the dependency files rather than the objects.
  # Note also that the ino rule creates a strangely named file.  This
  # is for compatibility with the standard ide even though it's dumb.
  #
  # Note that x.ino.d and x.ino.o do not depend on x.ino.  Instead
  # they depend on all .ino files, as the .d and .o files are created
  # by compiling a concatenation of all of the .ino files.  We use
  # $(wildcard) in the feedback to only show files that really exist,
  # for the case where the .ino file is not named the same as the
  # project.
  #
  # Note: CROSS_COMPILE_RULE adds the project ino build rule to the
  # more general set of rules in CROSS_LIBCOMPILE_RULE.
  #
  define CROSS_LIBCOMPILE_RULE
  $(1)/%.d $(1)/%.o: $(2)/%.cpp BOARD_INFO $4
	$$(TARGET)
	$(FEEDBACK)  "C++  $(if $3,[$3],[$$(dir $$<)]) $$(notdir $$<)"
	$(AT) $$(call requote,$$(recipe.cpp.o.pattern))
	$(AT) sed 's/\([^:]*\).o\s*:/\1.d \1.o:/' <$$@ >$$@d
	$(AT) mv $$@d $$@
  $(1)/%.d $(1)/%.o: $(2)/%.c BOARD_INFO $4
	$$(TARGET)
	$(FEEDBACK)  "C  $(if $3,[$3],[$$(dir $$<)]) $$(notdir $$<)"
	$(AT) $$(call requote,$$(recipe.c.o.pattern))
	$(AT) sed 's/\([^:]*\).o\s*:/\1.d \1.o:/' <$$@ >$$@d
	$(AT) mv $$@d $$@
  $(1)/%.S.d $(1)/%.S.o: $(2)/%.S BOARD_INFO $4
	$$(TARGET)
	$(FEEDBACK)  "AS  $(if $3,[$3],[$$(dir $$<)]) $$(notdir $$<)"
	$(AT) $$(call requote,$$(recipe.S.o.pattern))
	$(AT) sed 's/\([^:]*\).o\s*:/\1.d \1.o:/' <$$@ >$$@d
	$(AT) mv $$@d $$@

  endef

  define CROSS_COMPILE_RULE
  $(1)/$(PROJNAME).ino.d $(1)/$(PROJNAME).ino.o: BOARD_INFO $4
	$$(TARGET)
	$(FEEDBACK)  "C++  $$(wildcard $$(INO_MAIN)) $$(INO_INCLUSIONS)"
	$(AT) $$(call requote,$$(recipe.ino.o.pattern))
	$(AT) sed 's/\([^:]*\).o\s*:/\1.d \1.o:/' <$$@ >$$@d
	$(AT) mv $$@d $$@
  $(CROSS_LIBCOMPILE_RULE)
  endef

  # Rule for building arduino .a files.
  # $1 is the full pathname of the archive
  # $2 is the set of objects to go in to the archive
  #
  define CROSS_ARCHIVE_RULE
  $1: $2
	$$(TARGET)
	$$(FEEDBACK) AR [$$(basename $$(notdir $$@))] $$(notdir $$<)...
	$$(AT) $$(compiler.path)$$(compiler.ar.cmd) rcs $$@ $$^
	@# $(eval COMMANDS = $(shell dno_commands_for core.postbuild))
	@$(and $(COMMANDS),$(FEEDBACK_ECHO) Performing post-core...)
	$(AT) $(and $(COMMANDS),$(call indent,$(COMMANDS)))

  endef
endif

ifeq "$(HAVE_BUILD_TARGETS)" "t"
  # Macro for defining executable lines within recipes.
  #
  define RECIPE_LINE

	$$(AT) $$($1)
  endef

  # Define build rules for given source directories updating DEPS, our
  # list of generated dependency files, as we go.  Note that this is a
  # recursive macro which needs to be evaluated in order to actually
  # create the rules.
  #
  # Note that .ino files are handled differently from all other source
  # files.  To compile them we determine their function prototypes and
  # then concatenate these with the contents of those .ino files and
  # compile the result.
  #
  # For debugging this, use SHOW_RULES=y in your invocation
  #
  # The feedback macro calls below provide feedback when SHOW_RULES is defined.
  #   $1 - the name of the compile rule macro
  #   $2 - the target directory for objects
  #   $3 - the prioritised list of source directories
  #   $4 - lib paths (where to search for libraries)
  #   $5 - optional lib shortname to pass to compile_rules
  #   $6 - optional dependencies to pass into initial compile_rule
  #   $7 - optional variable into which to store deps discovered in
  #        initial invocation
  #   $8 - optional dependencies to pass into subsequent compile_rules
  #   $9 - optional variable into which to store deps discovered in
  #        subsequent (recursive) invocations
  #
  define ALL_BUILD_RULES
    $(shell mkdir -p $2)
    RULE_INO_SOURCES := $$(call uniqify,\
		            $$(call matching_files,*.ino,$3),\
	                    filepart)
    RULE_SOURCES := $$(call uniqify,\
		            $$(call matching_files,*.cpp *.c *.S,$3),\
	                    filepart)
    RULE_PROJ_INO := $$(call proj_ino,$$(RULE_INO_SOURCES),$$(PROJNAME))
    RULE_INO_SOURCES := $$(filter-out %/$$(PROJNAME).ino,$$(RULE_INO_SOURCES))
    RULE_DEPS := $$(patsubst %.o,%.d,$$(call to_objects,$2,\
			                $$(RULE_SOURCES) $$(RULE_PROJ_INO)))
    RULE_DIRS := $$(sort $$(dir $$(RULE_SOURCES) $$(RULE_PROJ_INO)))
    $$(call feedback,$(space) RULE_PROJ_INO: $$(RULE_PROJ_INO))
    $$(call feedback,$(space) RULE_SOURCES: $$(RULE_SOURCES))
    $$(call feedback,$(space) RULE_INO_SOURCES: $$(RULE_INO_SOURCES))
    $$(call feedback,$(space) RULE_DEPS: $$(RULE_DEPS))
    $$(call feedback,$(space) RULE_DIRS: $$(RULE_DIRS))
    $$(foreach dir,$$(RULE_DIRS),\
      $$(call feedback,$$(call $1,$2,$$(dir),\
	      $$(or $5,$$(call libname,$$(dir))),$6))\
      $$(eval $$(call $1,$2,$$(dir),$$(or $5,$$(call libname,$$(dir))),$6)))

    $$(and $7,$$(eval $7 += $$(RULE_DEPS)))
    $$(eval ALL_DEPS += $$(RULE_DEPS))
    $$(eval ALL_SOURCES += $$(RULE_SOURCES))
    $$(eval INO_MAIN += $$(RULE_PROJ_INO))
    $$(call feedback,$(space) INO_MAIN: $$(INO_MAIN))
    $$(eval INO_INCLUSIONS += $$(RULE_INO_SOURCES))
    $$(call feedback,$(space) INO_INCLUSIONS: $$(INO_INCLUSIONS))
    $$(call feedback,$(space) INCLUDING: $$(RULE_DEPS))
    # The inclusion of $$(RH_prebuild_TARGET) is intended to cause
    # library rediscovery if it is needed.
    include $$(RULE_DEPS) $$(RH_prebuild_TARGET)

    $$(foreach libdir,\
	       $$(foreach dir,$4,$$(call deplibs,$$(dir),$$(RULE_DEPS))),\
      $$(foreach lib,$$(call libname,$$(libdir)),\
        $$(if $$(filter-out $$(REQUIRED_LIBS), $$(lib)),\
          $$(eval REQUIRED_LIBS += $$(lib))\
          $$(eval $$(call ALL_BUILD_RULES,$1,$2/$$(lib),\
			  $$(libdir),$$4,$5,$8,$9,$8,$9)))))
  endef
endif

################################################################
# Discovery of source files and dynamic creation of build rules.
#

FQN2PQN = $(shell echo "$1" | sed -e 's/^\([^.]*.[^.]*.[^.]*\).*/\1/')

ifeq "$(IN_BOARD_DIR)" "t"
  PROJNAME = $(notdir $(realpath $(PROJDIR)))
  DIRNAME = $(notdir $(realpath $(BOARD_DIR)))

  ifeq "$(MAKE_RESTARTS)" ""
    # Check whether BOARD_INFO needs to be rebuilt due to changed
    # project name, board type, or selected board options.  We
    # physically remove the current BOARD_INFO file if so.

    # For safety we only run this code in our outer level of recursion
    # (see the ifeq above): the following code is very tightly coupled
    # with dno_bpp and dno_menu making it kinda brittle.  If things go
    # wrong we can get trapped into continual restarts: the above
    # conditional should prevent that from happening.  The worst case
    # behaviour then becomes that BOARD_INFO does not get rebuilt in
    # the cases described above, or that it always gets built
    # resulting in a full build every time.  Either way, dno remains
    # mostly functional.  If this happens please report a bug.

    # Before we include the BOARD_INFO file, we will check that it does
    # not need to be rebuilt.

    # If dno.mk used to exist but has been deleted, we'll remove the
    # BOARD_INFO to cause a rebuild.  Otherwise dno.mk is just a
    # dependency of BOAR_INFO
    ifneq "$(wildcard dno.mk)" "dno.mk"
      DNO_MK_USED != grep "^DNO_MK =" BOARD_INFO 2>/dev/null
      ifneq "" "$(DNO_MK_USED)"
        $(shell rm -f BOARD_INFO)
      endif
    endif 
    ifeq "BOARD_INFO" "$(wildcard BOARD_INFO)"
      # We have a BOARD_INFO file.  We must check that it is valid for
      # what we are trying to build...
      BI_PROJECT != sed -n -e '/^build.project.name *=/{s/.*= *\s//p}' \
          BOARD_INFO
      ifneq "$(PROJNAME)" "$(BI_PROJECT)"
        # Project name appears to have changed.  This BOARD_INFO file
        # has no remaining value and must be rebuilt.
        $(shell rm -f BOARD_INFO)
      else
        BI_BOARD != sed -n -e '/^BOARD_TYPE/{s/.*=\s//p}' BOARD_INFO
        ifneq "$(BOARD)" ""
          # BOARD parameter has been provided.
          BOARD_PQN != $(BPP) -t -f -s -n $(BOARD)
        else
          ifeq "BOARD_TYPE" "$(wildcard BOARD_TYPE)"
            # BOARD_TYPE file exists.
            BOARD_FQN != $(BPP) -t -f -n `cat BOARD_TYPE`
          else
            # Try to get board type from dirname
            BOARD_FQN != $(BPP) -t -f -n $(DIRNAME)
          endif
        endif
        BOARD_PQN := $(call FQN2PQN,$(BOARD_FQN))
        BI_BOARD_PQN := $(call FQN2PQN,$(BI_BOARD))
        $(call debug,BOARD_FQN)
        $(call debug,BOARD_PQN)
        $(call debug,BI_BOARD_PQN)

        ifneq "$(BOARD_PQN)" "$(BI_BOARD_PQN)"
          # Looks like board type has changed.  The current BOARD_INFO
          # file will need to be rebuilt: we force that by removing
	  # it.
          $(shell rm -f BOARD_INFO)
        else
          # Basic board type has not changed.  Let's check the selected
          # options: if they have changed, a full rebuild will be
          # needed.
          ifeq "BOARD_OPTIONS" "$(wildcard BOARD_OPTIONS)"
            # We have a BOARD_OPTIONS file.  Get BOARD_SELECTIONS from
            # it
            BOARD_SELECTIONS != \
              grep '^build.menu.selection' BOARD_OPTIONS | \
                    sed -e 's/^[^=]*=//'
          else
            # get BOARD_SELECTIONS from BOARD_PQN
            BOARD_SELECTIONS != $(MENU) -f $(BOARD_FQN)
          endif

          # Now see if BOARD_SELECTIONS matches what our BOARD_INFO
          # file says.
          BI_BOARD_SELECTIONS != \
              grep '^build.menu.selection' BOARD_INFO | \
                  sed -e 's/^[^=]*=//'
          ifneq "$(BOARD_SELECTIONS)" "$(BI_BOARD_SELECTIONS)"
            # BOARD_SELECTIONS have changed.  Force a rebuild of
            # BOARD_INFO
            $(info CHANGED: $(BI_BOARD_SELECTIONS) -> $(BOARD_SELECTIONS))
            $(info REMOVING BOARD_INFO)
            $(shell rm -f BOARD_INFO)
          endif
        endif

        ifeq "$(BOARD_PQN)" ""
          # Something went wrong with figuring out the board type.  Our
          # build cannot survive this.  Ensure dno fails with an error
          # message.
          $(error "$(MAKEFILE): Cannot identify board type")
        endif
      endif
    endif

    # Record any given board parameter.
    BOARD_PARAM=$(BOARD)
    # Ensure BOARD is defined.
    ifeq "$(BOARD)" ""
      ifeq "BOARD_TYPE" "$(wildcard BOARD_TYPE)"
        # BOARD_TYPE file exists.
        BI_DEPS += BOARD_TYPE
        BOARD := $(file < BOARD_TYPE)
        BOARD != $(BPP) -t -n -q $(BOARD)
      else
        BOARD != $(BPP) -t -n -q $(DIRNAME)
      endif
    endif

    ifeq "$(BOARD)" ""
      $(error "$(MAKEFILE): Cannot identify board type")
    endif

    ifneq "BOARD_INFO" "$(wildcard BOARD_INFO)"
      # No BOARD_INFO file.  We'd better clear out any existing build
      # directory as a full rebuild will be needed.
      $(shell rm -rf build)
    endif
  endif
endif

ifeq "$(HAVE_CROSS_BUILD_TARGETS)" "t"
  include BOARD_INFO $(wildcard BOARD_OPTIONS)

  ifdef  recipe.cpp.o.pattern
    # We only do the following if BOARD_INFO was successfully read.
    # This prevents a load of half-baked things happening in the event
    # that we are going to have to restart dno after building BOARD_INFO

    # Identify possible libraries.
    USER_LIB_DIRS = $(foreach root,$(USER_LIB_ROOTS),\
		      $(call is_lib,$(wildcard $(root)/*)))
    STD_LIB_DIRS = $(call is_lib,\
	$(wildcard $(runtime.platform.path)/libraries/*))

    ALL_LIB_DIRS := $(call uniqify,$(USER_LIB_DIRS) $(STD_LIB_DIRS),libname)
    CFLAGS += -Os -Wall
    CXXFLAGS += -Os -Wall

    # TODO: REMOVE THIS build.menu_selections = :$(shell dno_menu -f)

    $(call debug,STD_LIB_DIRS)
    $(call debug,ALL_LIB_DIRS)

    # A bunch of hacks to make compilation of ino files work.
    # We will create a recipe for compiling .ino files based on the
    # recipe for compiling .cpp files.  This will be modified to
    # compile a concatenation of the .ino files from standard input.
    #

    # Tell the compiler that the input is a c++ file (since there is
    # no file name from which it can infer it).  Also include the
    # standard Arduino header file as .ino files don't need to be
    # bothered with such trivial details.
    #
    ino_compiler_flags = -x c++ --include Arduino.h $(CXXFLAGS)

    # Define the recipe for compiling .ino files as described above.
    #
    $(eval recipe.ino.o.pattern = \
      set -o pipefail; dno_ino2c \
	$$(call QFILES,$$(INO_MAIN) $$(INO_INCLUSIONS)) | \
        $$(subst "$$(source_file)", $$(ino_compiler_flags) -, \
	        $(value recipe.cpp.o.pattern)))

    # define a pattern for uploading eeprom files.  Don't know why
    # this is not already defined: there is nothing about it in the
    # platform specification.  This is unlikely to work for anything
    # but avr boards.
    #
    recipe.eep.upload.pattern = \
	        $(subst flash:w,eeprom:w,\
		  $(subst .hex:i,.eep:i,\
		    $(subst .bin:i,.eep:i,\
		      $(tools.$(upload.tool).upload.pattern))))

    # And one for downloads
    timestamp := $(shell date +%Y%m%d_%H%M%S)
    recipe.eep.download.pattern = \
	        $(subst flash:w,eeprom:r,\
		  $(subst $(build.path)/$(build.project_name).,$(timestamp).,\
		    $(tools.$(upload.tool).upload.pattern)))

    source_file = $<
    object_file = $(@:.d=.o)
    build.path = $(BUILD_DIR)
    build.core.path = $(realpath $(runtime.platform.path)/cores/$(build.core))
    archive_file = libcore.a
    archive_file_path = $(build.path)/$(archive_file)

    WILL_COMPILE :=
    REQUIRED_LIBS :=
    ALL_DEPS :=
    sketch_deps :=
    lib_deps :=
    $(eval $(call ALL_BUILD_RULES,CROSS_COMPILE_RULE,\
		$(BUILD_DIR),$(SRC_DIRS),$(ALL_LIB_DIRS),,\
		$(RH_prebuild_TARGET) $(RH_presketch_TARGET),sketch_deps,\
		$(RH_prelib_TARGET),lib_deps))

    # Ideally, we would recalculate ALL_LIB_DIRS once we have
    # discovered what libararies are actually needed.  It is not
    # currently clear how we could do this (TODO).
    #
    ALL_LIB_FLAGS = $(foreach dir,$(ALL_LIB_DIRS) $(SRC_DIRS),-I $(dir))
    includes = -I $(build.core.path) -I $(build.variant.path) \
	       $(ALL_LIB_FLAGS)

    $(call debug,sketch_deps)
    $(call debug,lib_deps)
    $(call debug,REQUIRED_LIBS)
    $(call debug,REQUIRED_LIB_DIRS)
    $(call debug,ALL_DEPS)
    $(call debug,ALL_LIB_FLAGS)
    object_files := $(ALL_DEPS:.d=.o)
    sketch_objects := $(sketch_deps:.d=.o)
    lib_objects := $(lib_deps:.d=.o)

    # As a final step we make our main object depend on any other .ino
    # files that may exist.
    $(BUILD_DIR)/$(PROJNAME).ino.d: $(wildcard $(INO_MAIN)) $(INO_INCLUSIONS)

    ifeq "$(strip $(call unbuilt_deps,$(ALL_DEPS)))" ""
      # All Dependency files have been created.  We can now
      # define the build rules for libcore.  We make this conditional as
      # this makefile may restart multiple times as library
      # dependencies are resolved, and we don't want to create the rules
      # for the core objects until last.

      CORE_LIB_DIRS := $(shell find $(build.core.path) -type d)
      $(call debug,CORE_LIB_DIRS)
      core_deps :=
      $(eval $(call ALL_BUILD_RULES,CROSS_LIBCOMPILE_RULE,\
		$(BUILD_DIR)/libcore,$(CORE_LIB_DIRS),,core,\
		$(RH_precore_TARGET),core_deps))
      $(call debug,build.core.path)
      $(call debug,core_deps)
      CORE_OBJECTS = $(foreach obj,\
			     $(notdir $(call core_files,$(ALL_DEPS:.d=.o))),\
	             build/libcore/$(obj))
      $(call debug,CORE_OBJECTS)
      $(call feedback,$(call CROSS_ARCHIVE_RULE,$(archive_file_path),\
		      $(CORE_OBJECTS)))
      $(eval $(call CROSS_ARCHIVE_RULE,$(archive_file_path),$(CORE_OBJECTS)))
    endif

    TARGET_NAME = $(PROJNAME)
    ifeq "${recipe.objcopy.hex.pattern}" ""
      TARGET_HEX = 
    else
      TARGET_HEX = $(BUILD_DIR)/$(TARGET_NAME).hex
    endif
    ifeq "${recipe.objcopy.bin.pattern}" ""
      TARGET_BIN = 
    else
      TARGET_BIN = $(BUILD_DIR)/$(TARGET_NAME).bin
    endif

    TARGET_ELF = $(BUILD_DIR)/$(TARGET_NAME).elf
    TARGET_EEP = $(BUILD_DIR)/$(TARGET_NAME).eep
    $(call debug,TARGET_ELF)
    $(call debug,TARGET_EEP)
    $(call debug,TARGET_BIN)
    $(call debug,TARGET_HEX)
    OBJCOPY_PATTERNS := $(call uniqify,\
        $(shell grep "^recipe.objcopy\..*\.pattern=" BOARD_INFO | cut -d= -f1))

    $(call debug,OBJCOPY_PATTERNS)
    ifneq ($(strip $(upload.maximum_size)),)
      CHECK_SIZE = $(recipe.size.pattern) | $(BINDIR)/dno_checksize \
	  "$(recipe.size.regex)" "$(recipe.size.regex.data)" \
          "$(upload.maximum_size)" "$(upload.maximum_data_size)"
    else
      CHECK_SIZE = echo "Cannot determine flash memory of $(BOARD_TYPE).";\
                   echo "Make sure the size of $(TARGET_ELF) is" \
                        "less than $(BOARD_TYPE)'s flash memory"
    endif
  endif
endif

ifeq "$(HAVE_TEST_TARGETS)" "t"
  # This is for compiling and building unit tests.  We are using the host's
  # native compiler rather than a special cross-compiler.

  TEST_EXECUTABLE = $(BUILD_DIR)/$(notdir \
	              $(basename $(wildcard \
				   $(TEST_CODE_DIR)/test_$(TEST_LIB).cpp)))
  PROJNAME = $(TEST_LIB)

  PROJ_LIB_DIRS = $(foreach dir,\
		    $(shell find $(PROJDIR) -maxdepth 2 -name Arduino.h \
		            -exec dirname '{}' \;),\
		    $(if $(shell dno_dirinfo $(dir) | \
				     grep test_container),$(dir)))
  # STUBBED_LIBS gives us the names of libraries we have stubbed for testing.
  # This enables us to eliminate the real libraries from the build.
  #
  STUBBED_LIBS := $(patsubst %.h,./%,\
	            $(notdir $(wildcard $(PROJ_LIB_DIRS)/*.h) $(wildcard *.h)))

  USER_LIB_DIRS := $(subst $(strip $(STUBBED_LIBS)),,\
                      $(strip \
		        $(call uniqify, $(STUBBED_LIBS) $(TEST_LIB_DIR) \
		          $(foreach root,$(USER_LIB_ROOTS),\
		            $(call is_lib,$(wildcard $(root)/*))),libname)))
  ALL_LIB_DIRS := $(USER_LIB_DIRS) $(PROJ_LIB_DIRS) \
		  $(STD_LIB_DIRS) $(USER_LIB_ROOTS)
  CXXFLAGS += -g -O0 -Wall -DUNIT_TESTING -I . \
		$(foreach dir,$(ALL_LIB_DIRS),-I $(dir))

  $(eval $(call ALL_BUILD_RULES,NATIVE_COMPILE_RULE,\
	        $(BUILD_DIR),$(TEST_CODE_DIR),$(ALL_LIB_DIRS)))

  TEST_OBJECTS := $(patsubst %.d, %.o, $(ALL_DEPS))
  MAIN_TEST_OBJECT = $(TEST_EXECUTABLE).o
  SECONDARY_TEST_OBJECTS = $(call minus,$(TEST_OBJECTS),$(MAIN_TEST_OBJECT))
  $(call debug,ALL_LIB_DIRS)
  $(call debug,TEST_OBJECTS)
  $(call debug,MAIN_TEST_OBJECT)
  $(call debug,SECONDARY_TEST_OBJECTS)
endif

ifeq "$(DEFAULT_BUILD_TYPE)" "lib"
  TESTDIR = $(firstword \
	      $(foreach dir,$(shell find . -maxdepth 1 -mindepth 1 -type d),\
	        $(or $(filter %/test,${dir}),\
		     $(filter %/tests,${dir}),\
		     $(filter %/unit,${dir}))))
  ifneq "$(DOING_DOCS_BUILD)" ""
    DOC_SOURCES = $(wildcard *.md) \
		  $(wildcard docs/*.md) \
		  $(call matching_files,\
		    *.h *.cpp *.c *.S,\
		    $(shell find . -maxdepth 1 -type d \
                                 -a \! -name 'unit' -a \! -name 'tests' \
			         -a \! -name 'test' -a \! -name 'boot'))
  endif
  PROJNAME = $(notdir $(realpath $(shell pwd)))
else ifeq "$(DEFAULT_BUILD_TYPE)" "boot"
  # This is our best guess at the project name for a bootloader.  This
  # is for documentation purposes.  If this is wrong, put the project
  # name explicitly in Doxyfile. 
  #
  PROJNAME = $(basename \
	       $(notdir $(firstword $(call matching_files,*.c *.S,.))))
  ifneq "$(DOING_DOCS_BUILD)" ""
    DOC_SOURCES = $(call matching_files,\
		    *.h *.cpp *.c *.S,.)
  endif
else
  PROJNAME = $(notdir $(realpath $(PROJDIR)))
  ifneq "$(DOING_DOCS_BUILD)" ""
    DOC_SOURCES = $(call matching_files,\
		    *.h *.cpp *.c *.S,\
		    $(shell find $(PROJDIR) -maxdepth 2 -type d \
                                 -a \! -name 'unit' -a \! -name 'tests' \
			         -a \! -name 'test' -a \! -name 'boot'))
  endif
endif

$(call debug,PROJNAME)
$(call debug,PROJDIR)
$(call debug,DOC_SOURCES)


################################################################
# BOARD_INFO and related targets
#

.PHONY: show_boards install_extra_boards \
	show_extra_boards check_extra_boards

# Identify any platform.local.txt file: this will be a dependency for
# BOARD_INFO iff it exists.  Note that dno allows platform.local.txt
# to be placed in a code directory, where it will take prcedence over
# any other.
#
PLATFORM_LOCAL := $(firstword \
		    $(foreach dir,$(SRC_DIRS),\
		               $(wildcard $(dir)/platform.local.txt))\
		    $(wildcard ./platform.local.txt))
$(call debug,PLATFORM_LOCAL)

# Ditto for boards.local.txt
#
BOARDS_LOCAL := $(firstword \
	         $(foreach dir,$(SRC_DIRS),\
		           $(wildcard $(dir)/boards.local.txt))\
		 $(wildcard ./boards.local.txt))
$(call debug,BOARDS_LOCAL)
$(call debug,ALL_SOURCES)
$(call debug,BOARD)

# BOARD_INFO contains definitions needed by make to perform the
# various compilations, links, uploads, etc.  These definitions are
# specific to the chosen board-type which may be determined from a
# BOARD_TYPE file or the name of the current directory.
#

BOARD_INFO: $(BI_DEPS) $(PLATFORM_LOCAL) $(BOARDS_LOCAL) \
	    $(BOARD_FILE) $(PLATFORM_FILE) $(wildcard BOARD_OPTIONS) \
	     $(wildcard dno.mk) | check_extra_boards
	$(TARGET)
	$(FEEDBACK) Creating $@...
	$(AT)if $(BPP) -p $(BOARD) >$@2; then \
	    [ -f dno.mk ] && echo "DNO_MK = `pwd`/dno.mk" >>$@2; \
	    mv $@2 $@; \
	else \
	    rm -f $@2; false; fi

# PROGRAMMER contains definitions relating to Arduino programmers.
# These provide an alternate way of uploading programs, and are the
# only way, AFAK, to burn a bootoader.
#
PROGRAMMER:
	$(TARGET)
	$(FEEDBACK) Creating $@...
	$(AT) if [ "x$(PROGRAMMER)" != "x" ]; then \
	    if dno_prog -c $(PROGRAMMER); then \
		dno_prog -e $(PROGRAMMER) >PROGRAMMER; \
	    else \
	        echo -e "\n  ERROR: $(PROGRAMMER) is not a valid" \
		     "programmer name.\n" 1>&2; \
	        exit 1; \
	    fi; \
	else \
	    echo -e "\n  ERROR: PROGRAMMER not defined" 1>&2; \
	    echo "    add PROGRAMMER=<programmer name> to command line" 1>&2; \
	    echo -e "    (use dno list-programmers for values)\n" 1>&2; \
	    exit 1; \
	fi
# BOARD_TYPE identifies the type of board that we will be creating
# images for.  In its absence the name of the current directory may
# provide the board type.
#
BOARD_TYPE: $(BT_DEPS)
	$(TARGET)
	$(FEEDBACK) Creating $@...
	$(AT) $(BPP) -t -f $(BOARD) >$@ || \
	    (rm $@; \
	     echo "Unable to create $@.  Try dno help" 1>&2; \
	     false)

# This tests whether the contents of .dno_boards_paths looks ok.  If
# we have updated our Arduino tools, these entries could have been
# superceded.  Since this would not be an obvious thing to diagnose,
# this target is used to check the contents.  If any directories are
# invalid, we fail.  Note that this should only be used as an
# "order-only" dependency.
#
check_extra_boards:
	$(TARGET)
	@if [ -f  "$${HOME}/.dno_boards_paths" ]; then \
	    grep '^[[:space:]]*[^#]' $${HOME}/.dno_boards_paths | \
	      sed -e 's|^~|$(HOME)|' | \
	      while read dir; do \
	        [ -d "$${dir}" ] || \
		  { echo -e "\n  Invalid dir in $${HOME}/.dno_boards_paths:"\
		        "\n    \"$${dir}\"\n" 1>&2; exit 2; }\
	    done; fi


# Install another boards.txt to your user environment.  You need to
# define BOARDS_PATH on the command line, which must be the full path
# to a boards.txt file."
#
install_extra_boards:
	$(TARGET)
	$(AT) [ -f $(BOARDS_PATH) ] || \
	      [ -f $(BOARDS_PATH)/boards.txt ] || \
	      (echo "BOARDS_PATH must be defined and be the path" \
	            "to a boards.txt file." 1>&2; exit 2)
	$(AT) if [ "x$(notdir $(BOARDS_PATH))" = "xboards.txt" ]; then \
	    echo "$(dir $(BOARDS_PATH))" >>$(EXTRA_BOARDS_FILE); \
	else \
	    echo "$(BOARDS_PATH)" >>$(EXTRA_BOARDS_FILE); \
	fi

show_extra_boards:
	$(TARGET)
	@if [ -f $${HOME}/.dno_boards_paths ]; then \
	    echo "Supplemental boards.txt directories:"; \
	    sed -e 's/#.*//' -e 's/^/  /' $(EXTRA_BOARDS_FILE) | \
	        grep '[^[:space:]]'; \
	else \
	    echo "No supplemental boards.txt directories defined."; \
	fi

# List all supported boards.  You can narrow down the shown options by
# specifying BOARD on the command line.
#
ifneq "$(OPTIONS)" ""
    OPTIONS_PARAM=-o
  endif

show_boards:
	$(TARGET)
	$(AT) echo
	$(AT) echo "    Supported Arduino Board Types"
	$(AT) echo ============================================================
	$(AT) $(BPP) $(OPTIONS_PARAM) -l $(BOARD_TYPE) || true


################################################################
# Major targets
#

.PHONY: build root_code_info root_build_info lib unit_test \
	test tests unit size verify_size uknown

build: BOARD_INFO $(TARGET_HEX) $(TARGET_BIN) \
       $(TARGET_ELF) | check_extra_boards

unknown: | check_extra_boards
	@echo "make: Nothing to be done for 'unknown'."


ifeq "$(HAVE_CROSS_BUILD_TARGETS)" "t"

  $(TARGET_EEP): $(TARGET_ELF) $(RH_preobjcopy_TARGET)
	$(TARGET)
	$(FEEDBACK) OBJCOPY "(eep)" $(notdir $<)
	$(AT) ${recipe.objcopy.eep.pattern}
	@# $(eval COMMANDS := $(shell dno_commands_for objcopy.postobjcopy))
	@$(and $(COMMANDS),$(REPORT),echo $(TARGET_STR) build/.postobjcopy)
	$(AT) $(and $(COMMANDS),$(call indent,$(COMMANDS)))

  $(TARGET_HEX): $(TARGET_ELF) \
	       $(RH_presavehex_TARGET) $(RH_preobjcopy_TARGET)
	$(TARGET)
	$(FEEDBACK) OBJCOPY "(hex)" $(notdir $<)
	$(AT) ${recipe.objcopy.hex.pattern}
	@# $(eval COMMANDS := $(shell dno_commands_for savehex.postsavehex))
	@$(and $(COMMANDS),$(REPORT),echo $(TARGET_STR) build/.postsavehex)
	$(AT) $(and $(COMMANDS),$(call indent,$(COMMANDS)))
	$(AT)$(IFNOTQUIET) $(CHECK_SIZE)


  # BIN_TARGET_RECIPE is eval'd to define the $(TARGET_BIN) recipe.
  # Note that a RECIPE_LINE entry in the form:
  #   <tab>$$(AT) $$(<objcopy recipe name>)
  # is created for each entry in OBJCOPY_PATTERNS.  The need to do this
  # is why we eval this definition rather than simply placing it
  # verbatim below.
  #
  define BIN_TARGET_RECIPE
  $(TARGET_BIN): $(TARGET_ELF) 
	$$(TARGET)
	@# $$(eval COMMANDS = $$(shell dno_commands_for objcopy.preobjcopy))
	@$$(and $$(COMMANDS),$$(FEEDBACK_ECHO) Performing pre-objcopy...)
	$$(AT) $$(and $$(COMMANDS),$$(call indent,$$(COMMANDS)))
	$$(FEEDBACK) OBJCOPY "(bin)" $(notdir $$<)
	$$(AT) $$(recipe.objcopy.bin.pattern)
	@#$(foreach pattern,$(OBJCOPY_PATTERNS),$(call RECIPE_LINE,$(pattern)))
	@# $$(eval COMMANDS2 = $$(shell dno_commands_for objcopy.postobjcopy))
	@$$(and $$(COMMANDS2),$$(FEEDBACK_ECHO) Performing post-objcopy...)
	$$(AT) $$(and $$(COMMANDS2),$$(call indent,$$(COMMANDS2)))
	$$(AT)$$(IFNOTQUIET) $$(CHECK_SIZE)

  endef
  $(call feedback, BIN_TARGET_RECIPE $(call BIN_TARGET_RECIPE))
  $(eval $(call BIN_TARGET_RECIPE))

  # If files for ctags or etags are found, they become a dependency of
  # our elf target, so that they get automatically updated as needed. 
  #
  TAGFILES := $(wildcard TAGS) $(wildcard tags)

  $(TARGET_ELF): $(object_files) $(archive_file_path) \
	       $(TAGFILES) $(RH_postsketch_TARGET) \
	       $(RH_postlib_TARGET) $(RH_postcore_TARGET) \
	       $(RH_prelink_TARGET)
	$(TARGET)
	$(FEEDBACK) LD $(notdir $(object_files))
	$(AT) $(recipe.c.combine.pattern)
	@# $(eval COMMANDS := $(shell dno_commands_for linking.postlink))
	@$(and $(COMMANDS),$(REPORT),echo $(TARGET_STR) build/.postlink)
	$(AT) $(and $(COMMANDS),$(call indent,$(COMMANDS)))

  # We do not want the size verification targets to depend on
  # $(TARGET_ELF) as this will lead to prebuild, postbuild, etc
  # targets being built.  Instead we just check for the file existing.
  # Although this leaves open the possibility that the target is out
  # of date, it is probably better to check the size of the file that
  # exists, rather than building a new version and then checking it.
  #
  ENSURE_TARGET_ELF := $(AT) [ -f "$(TARGET_ELF)" ] || \
			( echo "$(TARGET_ELF) has not been built" 1>&2; \
			  exit 2 )

  size:   
	$(TARGET)
	$(ENSURE_TARGET_ELF)
	$(AT) $(CHECK_SIZE)

  verify_size:
	$(TARGET)
	$(ENSURE_TARGET_ELF)
	$(AT) $(CHECK_SIZE) >/dev/null
endif

root_code_info root_build_info:
	$(TARGET)
	$(AT) if [ "x$(BOARD)" != "x" ]; then \
	    $(MAKE) --no-print-directory BOARD_TYPE; \
	    $(MAKE) --no-print-directory;  \
	else \
	    echo "Nothing to be done here (in `pwd`)."; \
	    echo "Try dno ./BOARD_TYPE or dno tests"; \
	fi

lib:
	$(TARGET)
	$(AT)if [ "x$(strip $(TESTDIR))" = "x" ]; then\
	    echo "Nothing to be done here (in `pwd`)." \
		 " $(PROJ_DIR) Try creating unit tests.";\
	 else \
	    cd $(TESTDIR) && \
	        $(MAKE); \
	 fi

ifeq "$(DIR_TYPE)" "test"
  ifneq "$(HAVE_TEST_MAKEFILE)" ""
    unit_test test tests unit:
	$(TARGET)
	$(FEEDBACK) RUN local make
	$(AT) $(call indent,$(REAL_MAKE) --no-print-directory 2>&1)
	$(FEEDBACK) "...DONE ($(notdir $<))"
	@echo
  else
    unit_test test tests unit: $(TEST_EXECUTABLE) 
	$(TARGET)
	$(FEEDBACK) RUN $(notdir $<)...
	$(AT) $(call indent,$(TEST_EXECUTABLE))
	$(FEEDBACK) "...DONE ($(notdir $<))"
	@echo

    $(TEST_EXECUTABLE): $(TEST_OBJECTS) 
	$(TARGET) $(TEST_OBJECTS)
	$(FEEDBACK)  LD [$(notdir $@)]
	$(AT) g++ $(LDFLAGS) -o $@ $(MAIN_TEST_OBJECT) \
		$(SECONDARY_TEST_OBJECTS)
  endif
else 
  # Identify possible unit test directories
  #
  TEST_DIRS = $(shell find . -maxdepth 2 -type d -a \
	          \( -name tests -o -name test -o -name unit \))

  # Identify commands to be run for each unit test directory
  #
  test_cmds = $(foreach dir,$(TEST_DIRS),\
                  (cd $(dir); $(MAKE) test); )

  # Run unit tests for all libs
  unit_test test tests unit:
	@$(test_cmds)
endif

##
# BOOT STUFF FOLLOWS
# If burn is invoked explicitly in a board directory, it will attempt
# to reinstall the standard bootloader from the arduino installation.
# If it is run from a boot directory it will attempt to install the
# custom bootloader from that directory.  In either case because the
# consequences are serious, the user is asked to confirm.

.PHONY: boot burn default_boot_target

ifeq "$(DIR_TYPE)" "boot"
  # The boot image in the boot directory  has to be built by tools
  # outside of dno.  The tool to perform the build is defined in
  # BOOT_BUILDER and defaults to make.

  # PROGRAMMER_FILE is defined to be the local copy of the PROGRAMMER
  # file if it exists, or the parent directory's copy if that exists,
  # or the local copy (which will have to be created) if neither
  # exists.
  #
  PROGRAMMER_FILE = $(or $(wildcard PROGRAMMER),\
		         $(wildcard ../PROGRAMMER), PROGRAMMER)

  $(DEFAULT_BOOT_TARGET) boot: $(BOOT_DEPS)
	$(TARGET)
	$(FEEDBACK) CREATE BOOTIMAGE:
	$(AT) $(call indent,$(BOOT_BUILDER))

 # This target is used from a boot directory in order to rebuild
  # BOARD_INFO in the parent directory.  We use force to ensure that
  # this target is always run - this ensures that BOARD_INFO gets
  # updated if necessary.
  #
  ../BOARD_INFO:
	$(TARGET)
	$(AT) cd ..; dno BOARD_INFO --no-print-directory -s

  # If we are going to do a burn we must include the following files.
  # This will cause them to be rebuilt if necessary.
  ifneq "" "$(filter burn,$(MAKECMDGOALS))"
    include ../BOARD_INFO
    include $(PROGRAMMER_FILE)
  endif

  burn: $(BURN_DEPS) ../BOARD_INFO $(PROGRAMMER_FILE) check_device_path
	$(TARGET)
	@echo "About to burn bootloader: $(BOOTLOADER_IMAGE)"
	@$(call CONFIRM,Press Y to continue,Bailing out on user request)
	@# $(eval $(call SETVERBOSE,bootloader))
	$(AT) bloader=$(BOOTLOADER_IMAGE); \
	      burn_cmd=`echo $(tools.$(bootloader.tool).bootloader.pattern) |\
			sed -e "s!$(runtime.platform.path)/bootloaders/$(bootloader.file)!$${bloader}!"`; \
	       $(FEEDBACK_ECHO) Executing: $${burn_cmd}; \
	       $${burn_cmd}

else ifeq "$(findstring _board, $(DIR_TYPE))" "_board"
  $(DEFAULT_BOOT_TARGET) boot:
	@echo -e "\n  Error: Must be in a boot directory to build $@.\n" 1>&2
	@exit 2

  ifneq "" "$(filter burn,$(MAKECMDGOALS))"
    include BOARD_INFO
    include PROGRAMMER
  endif

  burn: $(PROGRAMMER_FILE) check_device_path
	$(TARGET)
	@echo "About to burn bootloader: $(runtime.platform.path)/bootloaders/$(bootloader.file)"
	@$(call CONFIRM,Press Y to continue,Bailing out on user request)
	$(FEEDBACK) "Burning bootloader: $(runtime.platform.path)/bootloaders/$(bootloader.file)"
	@# $(eval $(call SETVERBOSE,bootloader))
	$(AT) $(tools.$(bootloader.tool).bootloader.pattern)

else
  $(BOOT_TARGET) boot:
	@echo -e "\n  Error: Must be in a boot directory to build $@.\n" 1>&2
	@exit 2

  burn:
	@echo -e "\n  Error: Cannot burn bootloader images from"\
		  "$(DIR_TYPE) directories.\n" 1>&2
	@exit 2
endif

.PHONY: list-programmers show-programmers 

list-programmers listp:
	$(AT) dno_prog -l


################################################################
# documentation targets
# Build documentation files using Doxygen.
#
.PHONY: docs

# Note that DOC_SOURCES is determined in a pretty primitive way and
# will not necessarily be 100% correct.  It may contain files from
# unused libraries for example.  However this should be fine as the
# only downside is that docs may be determined to be out of date when
# the sources for those unused libraries have been updated.  This
# could, rarely, lead to an unnecessary docs rebuild.
#
docs/html: $(or $(USER_SOURCES),$(DOC_SOURCES)) docs/Doxyfile
	$(TARGET)
	@rm -rf html/*
	@$(FEEDBACK) "DOXYGEN $(PROJNAME)"
	$(AT)env PROJNAME="$(PROJNAME)" doxygen docs/Doxyfile || \
	  (echo "Doxygen fails: is it installed?"; exit 2)
	@touch $@

# When building docs ensure we are in an appropriate directory.
# doc directories and sub-board directories are generally not
# appropriate.
docs:
	$(TARGET)
	$(AT)if [ "x`dno_dirinfo`" = "xdocs" ]; then \
	    cd ..; \
	fi;  \
	if [ ! -d ./docs -a "x$(DIR_TYPE)" = "xsub_board" ]; then \
	    cd ..; \
	fi; \
        $(MAKE) --no-print-directory docs/html


endif #QUICKSTART

################################################################
# clean targets
# The do_xxx targets do the job without feedback.  The other targets go
# recursively into subdirectories and provide feedback.
#
.PHONY: tidy clean pristine extraclean do_clean do_tidy do_pristine

garbage += \\\#*  .\\\#*  *~ 
GENERATED_FILES=doxy.tag *.dbg

do_tidy:
	$(TARGET)
	$(AT) if [ x`dno_dirinfo` != 'xunknown' ]; then \
	     rm -f $(garbage); fi

tidy:
	$(TARGET)
	$(AT) if [ x`dno_dirinfo` != 'xunknown' ]; then \
	    echo Tidying `pwd` | sed -e 's!$(DNO_STARTDIR)!.!'; \
	    $(MAKE) --no-print-directory DNO_STARTDIR=$(DNO_STARTDIR) do_$@; \
	    $(RECURSE_FOR_SUBDIRS); \
	fi

ifeq "$(notdir $(CURDIR))" "boot"
  # If there is a Makefile in the boot directory, try running make clean.
  BOOTCLEAN = if [ -f Makefile -o -f GNUmakefile ]; then \
		$(REAL_MAKE) --no-print-directory clean >/dev/null 2>&1; \
              fi;
endif

do_clean:
	$(TARGET)
	$(AT) if [ x`dno_dirinfo` != 'xunknown' ]; then \
	    (rm -rf build 2>/dev/null || true); \
	    (rm -rf html 2>/dev/null || true); \
	    rm -f $(GENERATED_FILES); \
	    $(BOOTCLEAN) \
	fi

clean: do_clean do_tidy
	$(TARGET)
	$(AT) if [ x`dno_dirinfo` != 'xunknown' ]; then \
	    echo Cleaning `pwd` | sed -e 's!$(DNO_STARTDIR)!.!'; \
	    $(MAKE) --no-print-directory DNO_STARTDIR=$(DNO_STARTDIR) do_$@; \
	    $(RECURSE_FOR_SUBDIRS); \
	fi

do_pristine: 
	$(TARGET)
	$(AT) if [ x`dno_dirinfo` != 'xunknown' ]; then \
	    (rm BOARD_INFO PROGRAMMER TAGS tags 2>/dev/null || true); \
	fi

extraclean pristine: do_clean do_tidy
	$(TARGET)
	$(AT) if [ x`dno_dirinfo` != 'xunknown' ]; then \
	    echo Super-cleaning `pwd` | sed -e 's!$(DNO_STARTDIR)!.!'; \
	    $(MAKE) --no-print-directory \
		DNO_STARTDIR=$(DNO_STARTDIR) do_pristine; \
	    $(RECURSE_FOR_SUBDIRS); \
	fi


################################################################
# menu/options targets
#
.PHONY: menu options

menu options:
	$(AT) dno_menu


################################################################
# Device-handling targets
#
.PHONY: devices check_device_path reset monitor no-screen noscreen \
	cat upload eeprom_image eeprom do_upload do_uploadp do_eeprom \
	read_eeprom eeprom_read

# Attempt to determine the serial device to use for uploads and monitoring for
# DEVICE_PATH.  This is a best guess.  The caller may provide a definitive
# version of DEVICE_PATH.
#
DEVICE_PATHS = $(wildcard \
		/dev/ttyACM? /dev/ttyUSB? /dev/tty.usbserial* \
		/dev/tty.usbmodem* /dev/tty.wchusbserial*)

ifndef DEVICE_PATH
  DEVICE_PATH = $(firstword $(DEVICE_PATHS))
endif
serial.port = $(DEVICE_PATH)

# Give DEVICE_PATH a displayable <undefined> value if it is still not defined.
#
ifeq ($(strip $(DEVICE_PATH)),)
  DEVICE_PATH = <undefined>
endif

# List the possible available devices, where an Arduino may be plugged in.
#
devices:
	$(TARGET)
	@echo DEVICES: $(DEVICE_PATHS)

# Check that we have a DEVICE_PATH defined
#
check_device_path:
	$(TARGET)
	$(AT) if [ "x$(DEVICE_PATH)" = "x<undefined>" ]; then \
	    echo -e "\n  ERROR: No device detected or DEVICE_PATH provided\n" 1>&2; \
	    exit 2; fi

# Attempt to reset the Arduino on $(DEVICE_PATH).  This assumes that
# ard-reset-arduino is the right tool to use and is available.  If not, you're
# SOL.
#
reset: check_device_path
	$(TARGET)
	$(FEEDBACK) "Resetting device attached to ($(DEVICE_PATH))..."
	$(AT) ard-reset-arduino $(DEVICE_PATH)


# List of possible baud rates.  We look in our code for instances of these
# strings in order to try to find a suitable default.
#
ifndef MONITOR_BAUD
   SPEEDS = 300 1200 2400 4800 9600 14400 19200 28800 38400 57600 115200
   SPEED_REGEXP = [^0-9]\($(subst $(space),\|,$(SPEEDS))\)\([^0-9]\|$$\)
   USER_SOURCES = $(call matching_files,*.ino *.cpp *.c *.S, $(SRC_DIRS))
   $(call debug,SPEED_REGEXP)
   $(call debug,USER_SOURCES)
endif

# Run a serial monitor in screen.
# Note that we do our best to determine our baud rate by looking at
# the code for possible definitions of baud rates.  If multiple
# candidates are found, we pick the one with the highest value as that
# is the least likely number to have appeared in a different context.
# This will certainly fail to be correct from time to time, but the
# user always has the option of defining BAUD_RATE manually.
#
monitor: check_device_path
	$(TARGET)
	@# $(call SETBAUD)
	@$(FEEDBACK) "Running screenfrom $(DEVICE_PATH) at" \
		     "$(MONITOR_BAUD): C-a k to exit"
	$(AT)screen $(DEVICE_PATH) $(MONITOR_BAUD)

# cat is used to read the serial port and send it to stdout.
#
cat: check_device_path
	$(TARGET)
	@# $(call SETBAUD)
	@$(FEEDBACK) "Reading from $(DEVICE_PATH) at $(MONITOR_BAUD) baud."
	$(AT) stty -F $(DEVICE_PATH) speed $(MONITOR_BAUD) cs8 \
	    -cstopb -parenb >/dev/null
	$(AT) cat <$(DEVICE_PATH)

# Ensure there is no screen connected to the DEVICE.  Kill the screen if
# KILLSCREEN has been provided.
#
no_screen no-screen noscreen:
	$(TARGET)
	$(AT) procs=`screen -ls | grep Attached | \
		sed -e 's/^[ \t]*\([0-9]*\).*/\1/'`; \
	screenproc=`for p in $${procs}; do \
	  ps -fp $$p | grep $(DEVICE_PATH); done | awk '{print $$2}'`;	\
	if [ "x$${screenproc}" != "x" ]; then \
	  if [ "x$(KILLSCREEN)" = "x" ]; then \
	    echo "\n  ERROR: monitor is attached to $(DEVICE_PATH)" 1>&2; \
	    echo "    (Try noscreen KILLSCREEN=y)" 1>&2; \
	    exit 3; \
	  else \
	    echo "Killing attached screen..."; \
	    scr=`screen -ls | grep "$${screenproc}\." | awk '{print $$1}'`; \
	    screen -S $${scr} -p 0 -X quit; sleep 1; \
	  fi; \
	fi

# Ensure the eeprom file ($(TARGET_HEX)) is built and upload it to the DEVICE.
#
upload:	$(TARGET_HEX) verify_size reset
	$(TARGET)
	$(AT) $(MAKE) --no-print-directory do_upload

# This is used recursively from the upload target in order to separate any
# dependencies for this target from the main dependency graph.  This allows us
# to effectively on-upload actions such as ensuring there is no monitor
# attached to the DEVICE, without that preventing the build of the eeprom
# file.
#
do_upload: no_screen check_device_path
	$(TARGET)
	$(FEEDBACK) "  Uploading $(notdir $(TARGET_HEX)) to $(DEVICE_PATH)"
	@# $(eval $(call SETVERBOSE,upload))
	$(AT) $(tools.$(upload.tool).upload.pattern)
	@$(if $(call eq,$(verbose),n),echo upload complete.,true)

# If we are going to build the uploadp target, we need to include
# PROGRAMMER.
#
ifneq "" "$(filter do_uploadp,$(MAKECMDGOALS))"
  include PROGRAMMER
endif

# Upload using programmer, rather than directly.
#
uploadp: $(TARGET_HEX) verify_size PROGRAMMER
	$(TARGET)
	$(AT) $(MAKE) --no-print-directory do_uploadp
	@$(if $(call eq,$(verbose),n),echo upload complete.,true)

# Like do_upload, but for the uploadp target.  See the comments for
# do_upload.
#
do_uploadp: no_screen check_device_path
	$(TARGET)
	$(FEEDBACK) "  Uploading $(notdir $(TARGET_HEX)) to $(DEVICE_PATH)"
	@# $(eval $(call SETVERBOSE,program))
	$(AT) $(tools.$(program.tool).program.pattern)

eeprom_read read_eeprom: no_screen check_device_path
	$(TARGET)
	$(FEEDBACK) "  reading eeprom to $(timestamp).hex" \
		"using $(DEVICE_PATH)"
	$(AT) $(recipe.eep.download.pattern)

eeprom_image: $(TARGET_EEP) 
	$(TARGET)

eeprom:	$(TARGET_EEP) verify_size reset check_device_path
	$(TARGET)
	$(MAKE) do_eeprom

# Note that the verbosity thing below is a hack on top of the hack
# that is the definition of $(recipe.eep.upload.pattern).  It works
# for avr but will probably not for anything else.
#
do_eeprom: no_screen
	$(TARGET)
	$(FEEDBACK)
	$(FEEDBACK) "  writing eeprom from $(notdir $(TARGET_EEP))" \
		"using $(DEVICE_PATH)"
	@# $(eval $(call SETVERBOSE,upload))
	$(AT) $(recipe.eep.upload.pattern)


################################################################
# tags
# You only have to explicitly run the ctags or etags target once in
# each directory.  Once the tags file is created, the default build
# will ensure that it is kept up to date.
#
.PHONY: ctags etags

etags: TAGS

TAGS: $(ALL_SOURCES)
	$(TARGET)
	$(FEEDBACK) ETAGS $(wordlist 1,2,$<)...
	$(AT) etags $^

ctags: tags

tags: $(ALL_SOURCES)
	$(TARGET)
	$(FEEDBACK) CTAGS $(wordlist 1,2,$<)...
	$(AT) ctags $^


################################################################
# Directory Targets 
# These allow you to specify a board or lib directory as a target
# These targets run the default target in that directory so that you
# can run those targets from elsewhere in the project directory tree.
#
.PHONY: ALWAYS

# If our target is a board dir or lib dir, cd to that directory and
# call dno recursively, with no explicit target.
#
$(BOARD_DIRS) $(LIB_DIRS): ALWAYS
	$(TARGET)
	@if [ `pwd` != "$(PROJDIR)/$@" ]; then \
	    cd $(PROJDIR)/$@; \
	 fi; \
	 $(MAKE)


################################################################
# help targets
#
.PHONY: info help list
info:
	@echo -e "\n\
Dno ($(DNO_VERSION)) (pronounced dee-no) is a make-based system for \
developing\n\
Arduino software.\n\n\
Uusually dno can be run with no parameters and will do the right thing.  When\n\
you want to do something other than the default action, you give dno a\n\
\"target\" (eg dno upload) and it will perform the actions for that target.\n\
Use dno help to get a list of major targets.\n\n\
With dno you can use your favourite editor and simple command-line tools to\n\
develop well-tested and documented, professional-quality Arduino software.\n\n\
Dno uses a dedicated directory called \"$(BUILD_DIR)\" into which all object,\n\
library, executable, etc files are placed.\n\
\n\
Libaries may contain a \"tests\" (or \"test\" or \"unit\") directory into\n\
which unit tests may be placed.  Running dno in the library directory or its\n\
associated test directory will, by default, cause the unit tests to be\n\
compiled and run.  Common files for unit tests may be placed in a \"tests\"\n\
(or \"test\" or \"unit\") directory under the project root directory.\n\
\n\
Code directories may be for a specific board, in which case the directory\n\
name or a BOARD_TYPE file will identify the type of board (use dno BOARD_TYPE\n\
to create this), or may contain subdirectories for specific boards.  This\n\
allows a common codebase to be easily compiled for several boards.  Eg:\n\
\n\
    panel/\n\
    ├── Button\n\
    │   ├── Button.cpp\n\
    │   ├── Button.h\n\
    │   └── tests\n\
    │       ├── Arduino.h\n\
    │       ├── cppunit.h\n\
    │       └── test_Button.cpp\n\
    ├── panel.ino\n\
    ├── pro.8MHzatmega328\n\
    │   └── BOARD_INFO\n\
    └── uno\n\
        └── BOARD_INFO\n\
\n\
This shows a project directory, \"panel\", with a library, \"Button\",\n\
which contains unit tests, and 2 board directories, one for an Arduino Uno,\n\
and one for an 8MHz atmega 328 pro.  The BOARD_INFO files are created\n\
automatically by dno.  To build for the Uno, cd into the uno directory and\n\
run dno.  To build for the Promini, cd to pro.8MHzatmega328 and run dno.\n\
\n\
The board directories can also contain customised versions of the code from\n\
the parent directory and use customised libraries.  These take precedence\n\
over the parent directories' versions.\n" | $${PAGER:-more}

help:
	@echo -e "Usage:\n\
  dno [[target] [VARIABLE=value]]...\n\n\
Major dno commands/targets:\n\
  boot           - Build a bootloader image.  You need to be in a\n\
                   boot directory.\n\
  build          - Build the local arduino code (default target)\n\
  burn           - Burn a bootloader to an arduino using a programmer.\n\
  cat            - Cat the output from the board's serial port to\n\
                   stdout.  You may neet to set DEVICE_PATH and/or\n\
                   MONITOR_BAUD as for monitor (see below).\n\
  ctags          - Build a tags file from all sources.  Once created\n\
                   this will automatically be kept up to date by\n\
                   subsequent builds (ditto etags)\n\
  devices        - list the devices which may have an Arduino attached\n\
  eeprom         - upload an eeprom image to an attached Arduino.  You\n\
                   may need to define  DEVICE_PATH=<path to serial device>.\n\
  eeprom_image   - create the eeprom image for uploading using eeprom\n\
  eeprom_read    - download an eeprom image from a board\n\
  etags          - Build a TAGS file from all sources (see also ctags)\n\
  info           - provide a general description of dno\n\
  install_extra_boards\n\
                 - add another boards.txt file for consideration - \n\
                   define the full path to the file using BOARD_PATH=<path>\n\
  help           - provide a summary of the important targets\n\
  list           - list all available targets\n\
  list-programmers - list the set of available external programmers\n\
  menu           - invoke a menu system to select board options\n\
  monitor        - monitor the serial connection to the Arduino using\n\
                   the linux screen command.  You may need to define\n\
                   DEVICE_PATH=<path to serial device>.  You can also\n\
                   specify the baud rate in MONITOR_BAUD.  Use C-a k\n\
                   to kill screen\n\
  no-screen      - ensure that no screen is attached (see monitor)\n\
                   with KILLSCREEN=y, any connected screen is killed\n\
  options        - invoke a menu system to select board options\n\
  read_eeprom    - download an eeprom image from a board\n\
  reset          - attempt to reset the connected Arduino.  You may need\n\
                   to define DEVICE_PATH=<path to serial device>\n\
  show_boards    - show the available boards: provide BOARD=xx\n\
                   to narrow down the selected boards.  Define OPTIONS\n\
                   to show the options (eg cpu) for the shown boards.\n\
  BOARD_TYPE     - create a BOARD_TYPE file that identifies the board\n\
                   we are developing for.  Define BOARD= on the \n\
                   command line.\n\
  show_extra_boards\n\
                 - show the current set of extra boards.txt files\n\
  upload         - upload code to the Arduino.  You may need\n\
                   to define DEVICE_PATH=<path to serial device>\n\
  uploadp        - upload code to the Arduino using a programmer.\n\
		   As with upload you may need to define DEVICE_PATH.\n\
\n\
dno can usually be invoked with no targets and will do the right thing based\n\
on the directory it is run from.\n\n\
To increase feedback, define VERBOSE=y on the command line.\n\n\
For more developer information read the comments in\n\
  $(THIS_MAKEFILE)" | $${PAGER:-more}


# List of all targets except those that appear to be pattern-based
# or are full directory paths.  This gives us the targets you are
# most likely to be interested in.
#
list:
	$(AT) echo All dno targets:
	$(AT) $(REAL_MAKE) -pRrq -f $(THIS_MAKEFILE) : 2>/dev/null | \
	    awk '/^[^#]*:/ {if (($$0 !~ /\t/) && ($$0 !~ /=/)) \
		     {sub(/:.*/, ""); print}}' | uniq | \
	    grep -v '[%\\$$]' | grep '^[^/]' | sort -u | sed -e 's/^/  /'

$(eval $(DNO_FINAL))

# Local Variables:
# mode: makefile
# End:

